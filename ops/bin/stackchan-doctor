#!/usr/bin/env python3
"""Read-only diagnostics for the local StackChan OTA toolchain."""

from __future__ import annotations

import argparse
import glob
import hashlib
import json
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

ROOT_DIR = Path(__file__).resolve().parents[2]
ACTIVE_JSON = ROOT_DIR / "ops" / "ota" / "active.json"
ACTIVE_RELEASE_BIN = ROOT_DIR / "exp-pkg" / "active-release" / "stack-chan.bin"
OTA_BASE = "http://127.0.0.1:8080"
USB_LOGS_TOOL = ROOT_DIR / "ops" / "bin" / "stackchan-usb-logs"
CELEBRATE_DIAGNOSE_TOOL = ROOT_DIR / "ops" / "bin" / "stackchan-celebrate-diagnose"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def make_check(name: str, status: str, **details: Any) -> dict[str, Any]:
    return {"name": name, "status": status, **details}


def status_from_bool(ok: bool) -> str:
    return "ok" if ok else "error"


def run_cmd(argv: list[str], timeout: float = 5.0) -> tuple[int | None, str, str]:
    try:
        proc = subprocess.run(
            argv,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return proc.returncode, proc.stdout.strip(), proc.stderr.strip()
    except FileNotFoundError as exc:
        return None, "", str(exc)
    except subprocess.TimeoutExpired as exc:
        stdout = exc.stdout.decode("utf-8", errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
        return None, stdout.strip(), f"timeout after {timeout}s"


def run_json_tool(tool_path: Path, timeout: float = 10.0) -> dict[str, Any]:
    """Run a read-only helper with --json and normalize its result for doctor.

    Exit code 2 means the helper is unsupported/skipped in the current local
    context (for example no existing logs). It should not make doctor fail.
    """
    argv = [str(tool_path), "--json"]
    code, stdout, stderr = run_cmd(argv, timeout=timeout)
    result: dict[str, Any] = {
        "tool_path": str(tool_path),
        "command": argv,
        "exit_code": code,
        "status": "ok",
        "readonly": True,
    }

    data: Any = None
    parse_error: str | None = None
    if stdout:
        try:
            data = json.loads(stdout)
        except json.JSONDecodeError as exc:
            parse_error = str(exc)

    if data is not None:
        result["result"] = data
        child_overall = data.get("overall") if isinstance(data, dict) else None
        if child_overall is not None:
            result["overall"] = child_overall
        child_summary = data.get("summary") if isinstance(data, dict) else None
        if child_summary is not None:
            result["summary"] = child_summary
    elif stdout:
        result["stdout"] = stdout[-4000:]

    if stderr:
        result["stderr"] = stderr[-4000:]
    if parse_error:
        result["error"] = f"failed to parse JSON output: {parse_error}"
    if code is None:
        result["status"] = "warning"
        result.setdefault("error", stderr or "tool did not complete")
    elif code == 2:
        result["status"] = "skipped"
        result.setdefault("overall", "unsupported")
        result.setdefault("summary", "helper reported unsupported for this environment")
    elif code != 0:
        result["status"] = "warning"
        result.setdefault("error", stderr or parse_error or f"helper exited {code}")
    elif parse_error:
        result["status"] = "warning"
    elif result.get("overall") in ("warning", "error"):
        result["status"] = "warning"
    return result


def extension_check(name: str, node: dict[str, Any]) -> dict[str, Any]:
    status = node.get("status")
    if status == "skipped":
        check_status = "skipped"
    elif status == "ok":
        check_status = "ok"
    else:
        check_status = "warning"
    return make_check(
        name,
        check_status,
        tool_path=node.get("tool_path"),
        exit_code=node.get("exit_code"),
        overall=node.get("overall"),
        summary=node.get("summary"),
        error=node.get("error"),
        readonly=True,
    )


def http_request(method: str, path: str, timeout: float = 3.0) -> dict[str, Any]:
    url = f"{OTA_BASE}{path}"
    data = b"{}" if method == "POST" else None
    req = urllib.request.Request(url, method=method, data=data)
    if method == "POST":
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = b"" if method == "HEAD" else resp.read()
            return {
                "ok": True,
                "url": url,
                "status_code": resp.status,
                "headers": dict(resp.headers.items()),
                "body": body.decode("utf-8", errors="replace"),
            }
    except urllib.error.HTTPError as exc:
        body = b"" if method == "HEAD" else exc.read()
        return {
            "ok": False,
            "url": url,
            "status_code": exc.code,
            "headers": dict(exc.headers.items()) if exc.headers else {},
            "body": body.decode("utf-8", errors="replace"),
            "error": str(exc),
        }
    except Exception as exc:  # noqa: BLE001 - diagnostics should capture errors.
        return {"ok": False, "url": url, "error": str(exc)}


def parse_json_body(body: str) -> tuple[dict[str, Any] | None, str | None]:
    try:
        data = json.loads(body)
    except json.JSONDecodeError as exc:
        return None, str(exc)
    if not isinstance(data, dict):
        return None, "manifest JSON is not an object"
    return data, None


def manifest_summary(manifest: dict[str, Any] | None) -> dict[str, Any]:
    if not manifest:
        return {}
    fw = manifest.get("firmware") if isinstance(manifest.get("firmware"), dict) else {}
    return {
        "version": manifest.get("version"),
        "force": manifest.get("force"),
        "size": manifest.get("size"),
        "sha256": manifest.get("sha256"),
        "firmware.version": fw.get("version"),
        "firmware.force": fw.get("force"),
        "firmware.size": fw.get("size"),
        "firmware.sha256": fw.get("sha256"),
    }


def normalize_force(value: Any) -> int | None:
    if isinstance(value, bool):
        return 1 if value else 0
    if isinstance(value, int):
        return 1 if value else 0
    if isinstance(value, str):
        text = value.strip().lower()
        if text in ("1", "true", "yes", "y", "on", "force"):
            return 1
        if text in ("0", "false", "no", "n", "off", ""):
            return 0
    return None


def read_active_json() -> tuple[dict[str, Any] | None, str | None]:
    try:
        data = json.loads(ACTIVE_JSON.read_text(encoding="utf-8"))
    except Exception as exc:  # noqa: BLE001
        return None, str(exc)
    if not isinstance(data, dict):
        return None, "active.json is not a JSON object"
    return data, None


def find_esptool() -> list[str] | None:
    for cmd in ("esptool", "esptool.py"):
        found = shutil.which(cmd)
        if found:
            return [found]
    return [sys.executable, "-m", "esptool"]


def read_app_desc_version(bin_path: Path) -> tuple[str | None, str | None, str]:
    esptool = find_esptool()
    if not esptool:
        return None, "esptool not found", ""
    candidates = [esptool + ["image-info", str(bin_path)], esptool + ["image_info", str(bin_path)]]
    last_output = ""
    last_error = ""
    for argv in candidates:
        code, stdout, stderr = run_cmd(argv, timeout=20)
        output = "\n".join(part for part in (stdout, stderr) if part)
        last_output = output
        last_error = stderr
        if code == 0:
            match = re.search(r"^App version:\s*(\S+)\s*$", output, re.MULTILINE)
            if match:
                return match.group(1), None, " ".join(argv[:2])
            return None, "App version not found in esptool image_info output", " ".join(argv[:2])
    return None, last_error or last_output or "esptool image_info failed", " ".join(candidates[-1][:2])


def compare_manifest_pair(get_manifest: dict[str, Any] | None, post_manifest: dict[str, Any] | None) -> tuple[bool, list[str]]:
    mismatches: list[str] = []
    if get_manifest is None or post_manifest is None:
        return False, ["GET or POST manifest missing"]
    for key in ("version", "size", "sha256"):
        if get_manifest.get(key) != post_manifest.get(key):
            mismatches.append(f"{key}: GET={get_manifest.get(key)!r} POST={post_manifest.get(key)!r}")
    if normalize_force(get_manifest.get("force")) != normalize_force(post_manifest.get("force")):
        mismatches.append(f"force: GET={get_manifest.get('force')!r} POST={post_manifest.get('force')!r}")
    for key in ("version", "size", "sha256"):
        gv = (get_manifest.get("firmware") or {}).get(key) if isinstance(get_manifest.get("firmware"), dict) else None
        pv = (post_manifest.get("firmware") or {}).get(key) if isinstance(post_manifest.get("firmware"), dict) else None
        if gv != pv:
            mismatches.append(f"firmware.{key}: GET={gv!r} POST={pv!r}")
    gf = (get_manifest.get("firmware") or {}).get("force") if isinstance(get_manifest.get("firmware"), dict) else None
    pf = (post_manifest.get("firmware") or {}).get("force") if isinstance(post_manifest.get("firmware"), dict) else None
    if normalize_force(gf) != normalize_force(pf):
        mismatches.append(f"firmware.force: GET={gf!r} POST={pf!r}")
    return not mismatches, mismatches


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only StackChan OTA self-check.")
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument(
        "--check-device",
        action="store_true",
        help="also GET /dev/status (read-only); skipped by default",
    )
    parser.add_argument(
        "--include-usb-logs",
        action="store_true",
        help="include read-only output from ops/bin/stackchan-usb-logs --json",
    )
    parser.add_argument(
        "--include-celebrate-logs",
        action="store_true",
        help="include read-only output from ops/bin/stackchan-celebrate-diagnose --json",
    )
    args = parser.parse_args()

    checks: list[dict[str, Any]] = []

    code, stdout, stderr = run_cmd(["systemctl", "--user", "is-active", "stackchan-ota.service"])
    checks.append(
        make_check(
            "user_service_stackchan_ota",
            status_from_bool(code == 0 and stdout == "active"),
            state=stdout or None,
            error=stderr or None,
            readonly=True,
        )
    )

    active, active_err = read_active_json()
    checks.append(
        make_check(
            "active_json_read",
            status_from_bool(active is not None),
            path=str(ACTIVE_JSON),
            metadata=active if active is not None else None,
            error=active_err,
            readonly=True,
        )
    )

    manifests: dict[str, dict[str, Any] | None] = {}
    for method in ("GET", "POST"):
        resp = http_request(method, "/ota/")
        manifest, parse_err = parse_json_body(resp.get("body", "")) if resp.get("ok") else (None, resp.get("error"))
        manifests[method] = manifest
        checks.append(
            make_check(
                f"http_{method.lower()}_ota_manifest",
                status_from_bool(bool(resp.get("ok")) and manifest is not None),
                url=resp.get("url"),
                status_code=resp.get("status_code"),
                parsed=manifest_summary(manifest),
                error=parse_err,
                readonly=True,
            )
        )

    pair_ok, pair_mismatches = compare_manifest_pair(manifests.get("GET"), manifests.get("POST"))
    checks.append(
        make_check(
            "http_get_post_manifest_consistency",
            status_from_bool(pair_ok),
            mismatches=pair_mismatches,
            readonly=True,
        )
    )

    head = http_request("HEAD", "/stack-chan.bin")
    content_length = (head.get("headers") or {}).get("Content-Length")
    checks.append(
        make_check(
            "http_head_stack_chan_bin",
            status_from_bool(bool(head.get("ok")) and head.get("status_code") == 200),
            url=head.get("url"),
            status_code=head.get("status_code"),
            content_length=int(content_length) if content_length and content_length.isdigit() else content_length,
            error=head.get("error"),
            readonly=True,
        )
    )

    manifest = manifests.get("GET")
    active_manifest_ok = False
    active_manifest_mismatches: list[str] = []
    if active and manifest:
        if str(active.get("version")) != str(manifest.get("version")):
            active_manifest_mismatches.append(f"version: active.json={active.get('version')!r} HTTP={manifest.get('version')!r}")
        if normalize_force(active.get("force")) != normalize_force(manifest.get("force")):
            active_manifest_mismatches.append(f"force: active.json={active.get('force')!r} HTTP={manifest.get('force')!r}")
        fw = manifest.get("firmware") if isinstance(manifest.get("firmware"), dict) else {}
        if str(active.get("version")) != str(fw.get("version")):
            active_manifest_mismatches.append(f"firmware.version: active.json={active.get('version')!r} HTTP={fw.get('version')!r}")
        if normalize_force(active.get("force")) != normalize_force(fw.get("force")):
            active_manifest_mismatches.append(f"firmware.force: active.json={active.get('force')!r} HTTP={fw.get('force')!r}")
        active_manifest_ok = not active_manifest_mismatches
    else:
        active_manifest_mismatches.append("active.json or HTTP manifest missing")
    checks.append(
        make_check(
            "active_json_http_manifest_consistency",
            status_from_bool(active_manifest_ok),
            mismatches=active_manifest_mismatches,
            readonly=True,
        )
    )

    bin_details: dict[str, Any] = {"path": str(ACTIVE_RELEASE_BIN)}
    bin_ok = False
    if ACTIVE_RELEASE_BIN.exists():
        actual_size = ACTIVE_RELEASE_BIN.stat().st_size
        actual_sha = sha256_file(ACTIVE_RELEASE_BIN)
        bin_details.update({"size": actual_size, "sha256": actual_sha})
        expected_size = manifest.get("size") if manifest else None
        expected_sha = manifest.get("sha256") if manifest else None
        fw = manifest.get("firmware") if manifest and isinstance(manifest.get("firmware"), dict) else {}
        mismatches = []
        if expected_size != actual_size:
            mismatches.append(f"size: file={actual_size!r} manifest={expected_size!r}")
        if expected_sha != actual_sha:
            mismatches.append(f"sha256: file={actual_sha!r} manifest={expected_sha!r}")
        if fw.get("size") != actual_size:
            mismatches.append(f"firmware.size: file={actual_size!r} manifest={fw.get('size')!r}")
        if fw.get("sha256") != actual_sha:
            mismatches.append(f"firmware.sha256: file={actual_sha!r} manifest={fw.get('sha256')!r}")
        bin_details["mismatches"] = mismatches
        bin_ok = not mismatches
    else:
        bin_details["error"] = "active-release/stack-chan.bin missing"
    checks.append(make_check("active_release_bin_manifest_consistency", status_from_bool(bin_ok), **bin_details, readonly=True))

    app_version = None
    app_err = "active-release/stack-chan.bin missing"
    esptool_source = ""
    if ACTIVE_RELEASE_BIN.exists():
        app_version, app_err, esptool_source = read_app_desc_version(ACTIVE_RELEASE_BIN)
    manifest_version = manifest.get("version") if manifest else None
    app_ok = app_version is not None and str(app_version) == str(manifest_version)
    checks.append(
        make_check(
            "bin_app_desc_version_consistency",
            status_from_bool(app_ok),
            app_desc_version=app_version,
            manifest_version=manifest_version,
            method=esptool_source or "esptool image_info",
            error=None if app_ok else app_err,
            readonly=True,
        )
    )

    if args.check_device:
        dev = http_request("GET", "/dev/status")
        checks.append(
            make_check(
                "device_status_readonly",
                status_from_bool(bool(dev.get("ok")) and dev.get("status_code") == 200),
                url=dev.get("url"),
                status_code=dev.get("status_code"),
                body=dev.get("body"),
                error=dev.get("error"),
                readonly=True,
            )
        )
    else:
        checks.append(
            make_check(
                "device_status_readonly",
                "skipped",
                reason="default mode does not contact device endpoint; pass --check-device to GET /dev/status",
                readonly=True,
            )
        )

    ports = sorted(glob.glob("/dev/ttyACM*"))
    checks.append(make_check("usb_ttyacm_presence", "ok" if ports else "warning", ports=ports, readonly=True))

    checks.append(
        make_check(
            "cloud_token_route",
            "skipped",
            route="not_used",
            note="StackChan operations use local Dev HTTP, OTA user service, and read-only USB logs; Xiaozhi/cloud tokens are not a health item.",
            readonly=True,
        )
    )

    checks.append(
        make_check(
            "destructive_actions",
            "skipped_destructive",
            skipped=["service_restart", "device_reboot", "nvs_write", "ota_trigger", "firmware_flash"],
            readonly=True,
        )
    )

    usb_logs: dict[str, Any] | None = None
    if args.include_usb_logs:
        usb_logs = run_json_tool(USB_LOGS_TOOL)
        checks.append(extension_check("usb_logs_helper", usb_logs))

    celebrate_diagnosis: dict[str, Any] | None = None
    if args.include_celebrate_logs:
        celebrate_diagnosis = run_json_tool(CELEBRATE_DIAGNOSE_TOOL)
        checks.append(extension_check("celebrate_diagnosis_helper", celebrate_diagnosis))

    overall = "ok"
    if any(check["status"] == "error" for check in checks):
        overall = "error"
    elif any(check["status"] == "warning" for check in checks):
        overall = "warning"

    result = {
        "tool": "stackchan-doctor",
        "root": str(ROOT_DIR),
        "mode": "readonly",
        "check_device": bool(args.check_device),
        "overall": overall,
        "checks": checks,
    }
    if usb_logs is not None:
        result["usb_logs"] = usb_logs
    if celebrate_diagnosis is not None:
        result["celebrate_diagnosis"] = celebrate_diagnosis

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(f"stackchan-doctor: overall={overall} mode=readonly root={ROOT_DIR}")
        if usb_logs is not None:
            summary = usb_logs.get("summary") or f"exit_code={usb_logs.get('exit_code')}"
            print(f"usb_logs: overall={usb_logs.get('overall', usb_logs.get('status'))} summary={summary}")
        if celebrate_diagnosis is not None:
            summary = celebrate_diagnosis.get("summary") or f"exit_code={celebrate_diagnosis.get('exit_code')}"
            print(f"celebrate_diagnosis: overall={celebrate_diagnosis.get('overall', celebrate_diagnosis.get('status'))} summary={summary}")
        for check in checks:
            print(f"[{check['status']}] {check['name']}")
            for key, value in check.items():
                if key in ("name", "status") or value in (None, [], {}):
                    continue
                if key == "metadata":
                    print(f"  {key}: {json.dumps(value, ensure_ascii=False, sort_keys=True)}")
                else:
                    print(f"  {key}: {value}")
    return 1 if overall == "error" else 0


if __name__ == "__main__":
    raise SystemExit(main())
