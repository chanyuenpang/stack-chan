n<script type=\"text/javascript\" src=\"/bzzx/ssi/common_20286.js\"></script>\n<script type=\"text/javascript\">    var bf = new BarrierFree({noRegion: true})</script>\n<script type=\"text/javascript\">\nvar fujianSearchId = 'ff808081624641aa0162476c0e0e0055';\nvar searchId = '40280d11734c452c01734ff7b00c221c';\nvar showInput1 =  $('#header_inp1');\nvar siteId1 =  $('#siteId');\nvar siteKeyWord1 =  $('#siteKeyWord1');\nvar xmSearchId = '40280d1172da01550172dadfb0640004';\nvar isMain =  $('#isMain');\n$('.header_picker1').on(\"click\",function(){\nif(showInput1.val()!=\"\"){console.log(showInput1.val())}\n\tif(showInput1.val()==\"全省\"){\n\t\tshowInput1.val('本站');\n\t\tsiteId1.val(searchId);\n\t\tsiteKeyWord1.attr('name', 'keyWord');\n\t\t$('#searchForm').attr('action', '/bzzx/jsjj/');\n\t\tisMain.val(''); \n\t}else if(showInput1.val()==\"本站\"){\n\t\t\tsiteId1.val(''); \n\t\t\t$('#searchForm').attr('action', 'https://www.xm.gov.cn/so/s');\n\t\t\tshowInput1.val('站群');\n\t\t\tsiteKeyWord1.attr('name', 'qt');\n\t\t\tisMain.val(1); \n\t}else{\n\t\tshowInput1.val('全省');\n\t\tsiteId1.val(fujianSearchId);\n\t\t\tsiteKeyWord1.attr('name', 'key');\n\t\t$('#searchForm').attr('action', 'https://www.fujian.gov.cn/ssp/main/index.html');\n\t}\n})\n</script>\n<script type=\"text/javascript\">\n  $(function(){\n    require(['list'], function(objModel){\n      var _obj = objModel({\n        Mode:'letter',\n        objArgs:{\n          showStatic: true,\n          staticArgs:{\n            listArgs:{\n              siteId: 26,\n              chnlIds: '129',\n            }\n          }\n        },\n        pagebar:{\n          prepage:5\n        },cache:false,\n        num: 5\n      })\n    })\n  })\n</script>\n\n<script type=\"text/javascript\">\nvar chnlIds = '129';\n$(function(){\n $.ajax({     \n  type: \"get\",     \n  url: \"//cloud.xm.gov.cn/itp/interface/letter/count.action\",   \n  dataType: \"jsonp\",\n  beforeSend: function () {\n    $(\"#hdpt_ywzxtj\").append('<div style=\"text-align:center;margin: 15px;\"><img src=\"./images/loading.gif\" /></div>');\n  },\n  contentType: \"application/json; charset=utf-8\",     \n  data: {\"lateMonth\":6,\"chnlIds\":chnlIds},\n  success: function (data) {\n    $(\"#hdpt_ywzxtj\").empty();\n    $(\"#hdpt_ywzxtj\").append('总办结<b>'+data.count.ends+'</b>条,近半年收到留言<b>'+data.count.lateall+'</b>条,办结<b>'+data.count.lateends+'</b>条');\n  },     \n  error: function (XMLHttpRequest, textStatus, errorThrown) {     \n\n  }     \n});\n});\n</script>\n<script>\ncertifySwiper = new Swiper('#certify .swiper-container', {\n\twatchSlidesProgress: true,\n\tslidesPerView: 'auto',\n\tcenteredSlides: true,\n\tloop: true,\n\tloopedSlides: 5,\n\tautoplay: true,\n\tnavigation: {\n\t\tnextEl: '.swiper-button-next',\n\t\tprevEl: '.swiper-button-prev',\n\t},\n\tpagination: {\n\t\tel: '.swiper-pagination',\n\t\t//clickable :true,\n\t},\n\ton: {\n\t\tprogress: function (progress) {\n\t\t\tfor (i = 0; i < this.slides.length; i++) {\n\t\t\t\tvar slide = this.slides.eq(i);\n\t\t\t\tvar slideProgress = this.slides[i].progress;\n\t\t\t\tmodify = 1;\n\t\t\t\tif (Math.abs(slideProgress) > 1) {\n\t\t\t\t\tmodify = (Math.abs(slideProgress) - 1) * 0.3 + 1;\n\t\t\t\t}\n\t\t\t\ttranslate = slideProgress * modify * 260 + 'px';\n\t\t\t\tscale = 1 - Math.abs(slideProgress) / 5;\n\t\t\t\tzIndex = 999 - Math.abs(Math.round(10 * slideProgress));\n\t\t\t\tslide.transform('translateX(' + translate + ') scale(' + scale + ')');\n\t\t\t\tslide.css('zIndex', zIndex);\n\t\t\t\tslide.css('opacity', 1);\n\t\t\t\tif (Math.abs(slideProgress) > 3) {\n\t\t\t\t\tslide.css('opacity', 0);\n\t\t\t\t}\n\t\t\t}\n\t\t},\n\t\tsetTransition: function (swiper, transition) {\n\t\t\tfor (var i = 0; i < this.slides.length; i++) {\n\t\t\t\tvar slide = this.slides.eq(i)\n\t\t\t\tslide.transition(transition);\n\t\t\t}\n\n\t\t}\n\t}\n\n})\n</script>\n<script type=\"text/javascript\" src=\"./images/lazyLoadJS.js\"></script>\n<script type=\"text/javascript\">\nvar SITEID = 145;\nv