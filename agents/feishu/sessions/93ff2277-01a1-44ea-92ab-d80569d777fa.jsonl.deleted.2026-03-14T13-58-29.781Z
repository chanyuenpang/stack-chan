{"type":"message","id":"eb62084c","parentId":"d6bb4974","timestamp":"2026-03-13T13:24:28.363Z","message":{"role":"assistant","content":[{"type":"text","text":"✅ 收到！按\"厦门市科技局3月第2周公告汇总.docx\"命名，只收录3月6日-3月13日发布的公告，包含日期、名称、来源网址三要素。马上生成！"},{"type":"toolCall","id":"write:58","name":"write","arguments":{"path":"convert-weekly.js","content":"const { Document, Packer, Paragraph, TextRun, Table, TableRow, TableCell, BorderStyle, WidthType, HeadingLevel, AlignmentType, ExternalHyperlink } = require('docx');\nconst fs = require('fs');\n\n// 3月第2周（3月6日-3月13日）发布的公告数据\nconst announcements = [\n  {\n    date: \"2026-03-09\",\n    title: \"厦门市科学技术局关于开展2026年度新技术新产品应用场景征集的通知\",\n    url: \"http://sti.xm.gov.cn/xxgk/tzgg/202603/t20260309_2984616.htm\"\n  },\n  {\n    date: \"2026-03-09\",\n    title: \"厦门市科学技术局关于转发福建省科学技术厅开展技术合同认定登记服务点申报的通知\",\n    url: \"http://sti.xm.gov.cn/xxgk/tzgg/202603/t20260309_2984385.htm\"\n  },\n  {\n    date: \"2026-03-06\",\n    title: \"关于开展2026年《厦门市加快推进生物医药产业高质量发展若干措施》兑现工作的通知\",\n    url: \"http://sti.xm.gov.cn/xxgk/tzgg/202603/t20260306_2984321.htm\"\n  },\n  {\n    date: \"2026-03-06\",\n    title: \"厦门市科学技术局关于印发《关于支持企业加强研发活动加大研发投入的若干措施》的通知\",\n    url: \"http://sti.xm.gov.cn/xxgk/tzgg/202603/t20260306_2984248.htm\"\n  },\n  {\n    date: \"2026-03-05\",\n    title: \"厦门市高新技术企业认定专项工作组关于开展2026年国家级高新技术企业名称变更工作的通知\",\n    url: \"http://sti.xm.gov.cn/xxgk/tzgg/202603/t20260305_2984102.htm\"\n  },\n  {\n    date: \"2026-03-05\",\n    title: \"关于召开2025年度国家级高企（火炬高新区外）火炬统计调查暨高企统计工作会议的通知\",\n    url: \"http://sti.xm.gov.cn/xxgk/tzgg/202603/t20260305_2984101.htm\"\n  }\n];\n\n// 表格边框样式\nconst border = { style: BorderStyle.SINGLE, size: 1, color: \"000000\" };\nconst borders = { top: border, bottom: border, left: border, right: border };\n\n// 生成表格行\nfunction createTableRow(date, title, url, isHeader = false) {\n  const cellBg = isHeader ? \"D9E2F3\" : \"FFFFFF\";\n  const fontBold = isHeader;\n  const colWidths = [1500, 5500, 3000]; // 日期、名称、网址列宽\n\n  return new TableRow({\n    children: [\n      // 日期列\n      new TableCell({\n        borders,\n        width: { size: colWidths[0], type: WidthType.DXA },\n        shading: { fill: cellBg, type: \"clear\" },\n        margins: { top: 60, bottom: 60, left: 80, right: 80 },\n        verticalAlign: \"center\",\n        children: [new Paragraph({\n          alignment: \"center\",\n          children: [new TextRun({ text: date, bold: fontBold, size: 21 })]\n        })]\n      }),\n      // 名称列\n      new TableCell({\n        borders,\n        width: { size: colWidths[1], type: WidthType.DXA },\n        shading: { fill: cellBg, type: \"clear\" },\n        margins: { top: 60, bottom: 60, left: 80, right: 80 },\n        verticalAlign: \"center\",\n        children: [new Paragraph({\n          children: [new TextRun({ text: title, bold: fontBold, size: 21 })]\n        })]\n      }),\n      // 网址列\n      new TableCell({\n        borders,\n        width: { size: colWidths[2], type: WidthType.DXA },\n        shading: { fill: cellBg, type: \"clear\" },\n        margins: { top: 60, bottom: 60, left: 80, right: 80 },\n        verticalAlign: \"center\",\n        children: [isHeader ? \n          new Paragraph({\n            alignment: \"center\",\n            children: [new TextRun({ text: \"来源网址\", bold: fontBold, size: 21 })]\n          }) :\n          new Paragraph({\n            children: [new ExternalHyperlink({\n              children: [new TextRun({ text: \"点击查看\", color: \"0563C1\", underline: { type: \"single\" }, size: 21 })],\n              link: url\n            })]\n          })\n        ]\n      })\n    ]\n  });\n}\n\n// 创建文档\nconst doc = new Document({\n  styles: {\n    default: {\n      document: {\n        run: { font: \"宋体\", size: 24 }\n      }\n    },\n    paragraphStyles: [\n      {\n        id: \"Heading1\",\n        name: \"Heading 1\",\n        basedOn: \"Normal\",\n        next: \"Normal\",\n        quickFormat: true,\n        run: { size: 36, bold: true, font: \"黑体\" },\n        paragraph: { spacing: { before: 240, after: 120 } }\n      }\n    ]\n  },\n  sections: [{\n    properties: {\n      page: {\n        size: { width: 11906, height: 16838 },\n        margin: { top: 1440, right: 1440, bottom: 1440, left: 1440 }\n      }\n    },\n    children: [\n      // 标题\n      new Paragraph({\n        heading: \"Heading1\",\n        alignment: AlignmentType.CENTER,\n        children: [new TextRun(\"厦门市科技局3月第2周公告汇总\")]\n      }),\n      new Paragraph({\n        alignment: AlignmentType.CENTER,\n        spacing: { after: 240 },\n        children: [new TextRun({ text: \"统计周期：2026年3月6日 - 3月13日 | 数据来源：厦门市科技局官网\", size: 20 })]\n      }),\n\n      // 表格说明\n      new Paragraph({\n        spacing: { after: 120 },\n        children: [new TextRun({ text: \"本周共发布6条公告，详情如下：\", bold: true })]\n      }),\n\n      // 表头\n      createTableRow(\"发布日期\", \"公告名称\", \"来源网址\", true),\n      // 数据行\n      ...announcements.map(item => createTableRow(item.date, item.title, item.url))\n    ]\n  }]\n});\n\n// 生成文件\nPacker.toBuffer(doc).then(buffer => {\n  fs.writeFileSync(\"厦门市科技局3月第2周公告汇总.docx\", buffer);\n  console.log(\"✅ DOCX文件生成成功：厦门市科技局3月第2周公告汇总.docx\");\n}).catch(err => {\n  console.error(\"❌ 生成失败：\", err);\n});\n"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773408110173}}
