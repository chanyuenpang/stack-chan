{"type":"message","id":"7edd266e","parentId":"0649f360","timestamp":"2026-03-14T08:53:09.566Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在创建分析脚本。我需要使用 Playwright 来访问这3个网站，分析页面结构并截图。\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_39fb962605fc4332bf64337e","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/analyze_sites.js","content":"const { chromium } = require('playwright');\nconst fs = require('fs');\nconst path = require('path');\n\nconst sites = [\n  {\n    name: '厦门市人力资源和社会保障局',\n    url: 'http://hrss.xm.gov.cn/xygk/tzgg/',\n    outputDir: '/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/.learnings'\n  },\n  {\n    name: '厦门科学技术局',\n    url: 'http://sti.xm.gov.cn/xxgk/tzgg/',\n    outputDir: '/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/.learnings'\n  },\n  {\n    name: '福建省科技厅',\n    url: 'http://www.fujian.gov.cn/xwdt/fjyw/',\n    outputDir: '/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/.learnings'\n  }\n];\n\nasync function analyzeSite(site) {\n  console.log(`\\n=== 分析: ${site.name} ===`);\n  console.log(`URL: ${site.url}`);\n  \n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext();\n  const page = await context.newPage();\n  \n  try {\n    await page.goto(site.url, { waitUntil: 'networkidle', timeout: 30000 });\n    await page.waitForTimeout(2000);\n    \n    // 截图\n    const screenshotPath = path.join(site.outputDir, `${site.name.replace(/[^a-zA-Z0-9]/g, '_')}_screenshot.png`);\n    await page.screenshot({ path: screenshotPath, fullPage: true });\n    console.log(`截图已保存: ${screenshotPath}`);\n    \n    // 分析页面结构\n    const analysis = await page.evaluate(() => {\n      const results = {\n        containers: [],\n        items: [],\n        titles: [],\n        links: []\n      };\n      \n      // 查找可能的列表容器\n      const possibleContainers = ['ul', 'ol', 'div'];\n      possibleContainers.forEach(tag => {\n        const elements = document.querySelectorAll(tag);\n        elements.forEach(el => {\n          if (el.children.length > 3) { // 至少3个子元素\n            const className = el.className || '';\n            const id = el.id || '';\n            const childCount = el.children.length;\n            // 检查是否包含链接\n            const linkCount = el.querySelectorAll('a').length;\n            if (linkCount > 3) {\n              results.containers.push({\n                tag: tag,\n                class: className.substring(0, 50),\n                id: id,\n                children: childCount,\n                links: linkCount\n              });\n            }\n          }\n        });\n      });\n      \n      // 查找列表项\n      const listItems = document.querySelectorAll('li, div');\n      listItems.forEach(el => {\n        const links = el.querySelectorAll('a');\n        if (links.length > 0) {\n          const className = el.className || '';\n          results.items.push({\n            tag: el.tagName.toLowerCase(),\n            class: className.substring(0, 50),\n            linkCount: links.length\n          });\n        }\n      });\n      \n      // 查找标题元素\n      const titleElements = document.querySelectorAll('h1, h2, h3, h4, .title, .news-title, .article-title, [class*=\"title\"]');\n      titleElements.forEach(el => {\n        results.titles.push({\n          tag: el.tagName.toLowerCase(),\n          class: (el.className || '').substring(0, 50),\n          text: (el.textContent || '').trim().substring(0, 30)\n        });\n      });\n      \n      // 查找链接\n      const allLinks = document.querySelectorAll('a');\n      allLinks.slice(0, 10).forEach(el => {\n        results.links.push({\n          href: (el.href || '').substring(0, 80),\n          text: (el.textContent || '').trim().substring(0, 30)\n        });\n      });\n      \n      return results;\n    });\n    \n    // 更精确的分析：找公告列表\n    const preciseAnalysis = await page.evaluate(() => {\n      // 尝试多种选择器模式\n      const selectors = {\n        container: [\n          '.news-list', '.notice-list', '.list-box', '.tzgg-list',\n          'ul.list', 'div.list', '.article-list', '[class*=\"list\"]',\n          '.xw-list', '.info-list', 'ul', 'div.ul'\n        ],\n        item: [\n          'li', 'div.item', 'div.news-item', 'div.list-item',\n          '[class*=\"item\"]', 'tr'\n        ],\n        title: [\n          'a[title]', 'span.title', 'div.title', '.news-title',\n          '[class*=\"title\"]', 'h3', 'h4'\n        ]\n      };\n      \n      let bestContainer = null;\n      let bestItem = null;\n      let bestTitle = null;\n      \n      // 找容器\n      for (const sel of selectors.container) {\n        const els = document.querySelectorAll(sel);\n        for (const el of els) {\n          const links = el.querySelectorAll('a');\n          if (links.length >= 5) {\n            bestContainer = {\n              selector: sel,\n              tag: el.tagName.toLowerCase(),\n              class: el.className || '',\n              id: el.id || '',\n              linkCount: links.length\n            };\n            break;\n          }\n        }\n        if (bestContainer) break;\n      }\n      \n      // 找公告项\n      if (bestContainer) {\n        const container = document.querySelector(bestContainer.selector);\n        if (container) {\n          const possibleItems = container.querySelectorAll('li, div');\n          for (const item of possibleItems) {\n            const link = item.querySelector('a');\n            if (link) {\n              bestItem = {\n                selector: item.tagName.toLowerCase(),\n                class: item.className || ''\n              };\n              // 找标题\n              const titleEl = item.querySelector('a[title], span, div.title, .news-title');\n              if (titleEl) {\n                bestTitle = {\n                  selector: titleEl.tagName.toLowerCase() + (titleEl.className ? '.' + titleEl.className.split(' ').join('.') : ''),\n                  text: (titleEl.textContent || '').trim().substring(0, 30)\n                };\n              }\n              break;\n            }\n          }\n        }\n      }\n      \n      return { container: bestContainer, item: bestItem, title: bestTitle };\n    });\n    \n    console.log('精确分析结果:', JSON.stringify(preciseAnalysis, null, 2));\n    \n    await browser.close();\n    \n    return {\n      site: site.name,\n      url: site.url,\n      screenshot: screenshotPath,\n      analysis: preciseAnalysis\n    };\n    \n  } catch (error) {\n    console.error(`分析失败: ${error.message}`);\n    await browser.close();\n    return {\n      site: site.name,\n      url: site.url,\n      error: error.message\n    };\n  }\n}\n\nasync function main() {\n  const results = [];\n  for (const site of sites) {\n    const result = await analyzeSite(site);\n    results.push(result);\n  }\n  \n  console.log('\\n=== 最终结果 ===');\n  console.log(JSON.stringify(results, null, 2));\n}\n\nmain().catch(console.error);"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773478269847}}
