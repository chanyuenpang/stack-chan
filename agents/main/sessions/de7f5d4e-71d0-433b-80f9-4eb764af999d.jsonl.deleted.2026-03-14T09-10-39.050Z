{"type":"message","id":"e1c7e7e5","parentId":"079ada20","timestamp":"2026-03-14T08:11:51.753Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Playwright 已安装。现在我需要用 Playwright 访问这3个网站并提取公告列表。让我写一个 Python 脚本来完成这个任务。\n\n目标网站：\n1. http://hrss.xm.gov.cn/xygk/tzgg/ - 厦门市人力资源和社会保障局\n2. http://sti.xm.gov.cn/ - 厦门科学技术局\n3. http://kjt.fujian.gov.cn/ - 福建省科技厅\n\n我需要写一个脚本来抓取这些网站的公告。\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_51c0b3f9fd5c47d1a3fe4083","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/scrape_announcements.py","content":"#!/usr/bin/env python3\n\"\"\"公告抓取脚本 - 使用 Playwright\"\"\"\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport re\nfrom datetime import datetime\n\nresults = {}\n\nasync def scrape_xm_hrss():\n    \"\"\"厦门市人力资源和社会保障局\"\"\"\n    print(\"抓取: 厦门市人力资源和社会保障局...\")\n    try:\n        async with async_playwright() as p:\n            browser = await p.chromium.launch(headless=True)\n            page = await browser.new_page()\n            await page.goto(\"http://hrss.xm.gov.cn/xygk/tzgg/\", timeout=30000)\n            await page.wait_for_load_state(\"networkidle\", timeout=15000)\n            \n            # 提取公告列表\n            announcements = []\n            \n            # 尝试多种选择器\n            selectors = [\n                \"ul.news_list li a\",\n                \"div.list_box a\",\n                \"table.list_table a\",\n                \".news-list a\",\n                \".tzgg-list a\"\n            ]\n            \n            for sel in selectors:\n                items = await page.query_selector_all(sel)\n                if items:\n                    for item in items[:10]:\n                        title = await item.inner_text()\n                        href = await item.get_attribute(\"href\")\n                        if title and href:\n                            # 尝试获取日期\n                            date_elem = await item.query_selector(\"span.date, .date, .time\")\n                            date_text = \"\"\n                            if date_elem:\n                                date_text = await date_elem.inner_text()\n                            if not date_text:\n                                # 尝试从父元素获取日期\n                                parent = await item.query_selector(\"xpath=../..\")\n                                if parent:\n                                    date_text = await parent.inner_text()\n                            \n                            announcements.append({\n                                \"title\": title.strip(),\n                                \"date\": date_text.strip() if date_text else \"\",\n                                \"url\": href if href.startswith(\"http\") else f\"http://hrss.xm.gov.cn{href}\" if href.startswith(\"/\") else f\"http://hrss.xm.gov.cn/xygk/tzgg/{href}\"\n                            })\n                    if announcements:\n                        break\n            \n            await browser.close()\n            return announcements\n    except Exception as e:\n        print(f\"厦门市人力资源和社会保障局 抓取失败: {e}\")\n        return []\n\nasync def scrape_xm_sti():\n    \"\"\"厦门科学技术局\"\"\"\n    print(\"抓取: 厦门科学技术局...\")\n    try:\n        async with async_playwright() as p:\n            browser = await p.chromium.launch(headless=True)\n            page = await browser.new_page()\n            await page.goto(\"http://sti.xm.gov.cn/\", timeout=30000)\n            await page.wait_for_load_state(\"networkidle\", timeout=15000)\n            \n            announcements = []\n            \n            # 查找公告列表\n            selectors = [\n                \"div.news-list a\",\n                \"ul.news-list li a\",\n                \".notice-list a\",\n                \".tzgg a\"\n            ]\n            \n            for sel in selectors:\n                items = await page.query_selector_all(sel)\n                if items:\n                    for item in items[:10]:\n                        title = await item.inner_text()\n                        href = await item.get_attribute(\"href\")\n                        if title and href:\n                            announcements.append({\n                                \"title\": title.strip(),\n                                \"date\": \"\",\n                                \"url\": href if href.startswith(\"http\") else f\"http://sti.xm.gov.cn{href}\"\n                            })\n                    if announcements:\n                        break\n            \n            await browser.close()\n            return announcements\n    except Exception as e:\n        print(f\"厦门科学技术局 抓取失败: {e}\")\n        return []\n\nasync def scrape_fj_kjt():\n    \"\"\"福建省科技厅\"\"\"\n    print(\"抓取: 福建省科技厅...\")\n    try:\n        async with async_playwright() as p:\n            browser = await p.chromium.launch(headless=True)\n            page = await browser.new_page()\n            await page.goto(\"http://kjt.fujian.gov.cn/\", timeout=30000)\n            await page.wait_for_load_state(\"networkidle\", timeout=15000)\n            \n            announcements = []\n            \n            selectors = [\n                \"div.news-list a\",\n                \"ul.news-list li a\",\n                \".notice-list a\",\n                \".tzgg-list a\"\n            ]\n            \n            for sel in selectors:\n                items = await page.query_selector_all(sel)\n                if items:\n                    for item in items[:10]:\n                        title = await item.inner_text()\n                        href = await item.get_attribute(\"href\")\n                        if title and href:\n                            announcements.append({\n                                \"title\": title.strip(),\n                                \"date\": \"\",\n                                \"url\": href if href.startswith(\"http\") else f\"http://kjt.fujian.gov.cn{href}\"\n                            })\n                    if announcements:\n                        break\n            \n            await browser.close()\n            return announcements\n    except Exception as e:\n        print(f\"福建省科技厅 抓取失败: {e}\")\n        return []\n\nasync def main():\n    # 并行抓取\n    tasks = [\n        scrape_xm_hrss(),\n        scrape_xm_sti(),\n        scrape_fj_kjt()\n    ]\n    \n    results = await asyncio.gather(*tasks)\n    \n    return {\n        \"厦门市人力资源和社会保障局\": results[0],\n        \"厦门科学技术局\": results[1],\n        \"福建省科技厅\": results[2]\n    }\n\nif __name__ == \"__main__\":\n    import json\n    data = asyncio.run(main())\n    print(json.dumps(data, ensure_ascii=False, indent=2))"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773475827963}}
