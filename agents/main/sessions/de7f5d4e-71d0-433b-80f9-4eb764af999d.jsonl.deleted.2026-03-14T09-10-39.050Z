\", timeout=30000, wait_until=\"networkidle\")\n        \n        items = await page.evaluate(\"\"\"() => {\n            const lis = document.querySelectorAll('li');\n            const result = [];\n            lis.forEach(li => {\n                const text = li.innerText;\n                const a = li.querySelector('a');\n                // 匹配: 标题 + 换行 + 日期\n                const match = text.match(/([^\\n]+)\\n(\\d{4}-\\d{2}-\\d{2})/);\n                if (match && a && match[1].trim().length > 3) {\n                    result.push({\n                        title: match[1].trim(),\n                        date: match[2],\n                        href: a.href\n                    });\n                }\n            });\n            return result;\n        }\"\"\")\n        results[\"厦门科学技术局\"] = items[:10]\n        \n        # 3. 福建科技厅\n        print(\"抓取: 福建省科技厅...\")\n        await page.goto(\"http://kjt.fujian.gov.cn/xxgk/tzgg/\", timeout=30000, wait_until=\"networkidle\")\n        \n        items = await page.evaluate(\"\"\"() => {\n            const lis = document.querySelectorAll('li');\n            const result = [];\n            lis.forEach(li => {\n                const text = li.innerText;\n                const a = li.querySelector('a');\n                const match = text.match(/([^\\n]+)\\n(\\d{4}-\\d{2}-\\d{2})/);\n                if (match && a && match[1].trim().length > 3 && text.length < 150) {\n                    result.push({\n                        title: match[1].trim(),\n                        date: match[2],\n                        href: a.href\n                    });\n                }\n            });\n            return result;\n        }\"\"\")\n        results[\"福建省科技厅\"] = items[:10]\n        \n        await browser.close()\n    \n    return results\n\nresults = asyncio.run(scrape_all())\n\n# 生成 Markdown\nmd_content = \"\"\"# 公告列表 - 2026-03-14\n\n> 抓取时间: 2026-03-14\n\n---\n\n## 厦门市人力资源和社会保障局\n\n| 标题 | 发布日期 | 链接 |\n|------|------