{"type":"message","id":"44bfda88","parentId":"ff1828e3","timestamp":"2026-03-14T08:16:09.886Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"我需要把代码放到async函数里。让我修复这个问题。\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_45cb3777f7d148339afa97bd","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/scrape_v2.py","content":"#!/usr/bin/env python3\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport re\nimport json\n\nasync def scrape_xm_hrss():\n    \"\"\"厦门市人力资源和社会保障局\"\"\"\n    print(\"抓取: 厦门市人力资源和社会保障局...\")\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        await page.goto(\"http://hrss.xm.gov.cn/xygk/tzgg/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        content = await page.content()\n        \n        # 使用正则提取通知公告\n        pattern = r'\\[(\\d{4}-\\d{2}-\\d{2})\\]\\s*([^\\n<]{5,80}?)</li>'\n        matches = re.findall(pattern, content)\n        \n        announcements = []\n        for date, title in matches[:10]:\n            title = title.strip()\n            if title and len(title) > 5:\n                href = \"\"\n                if title in content:\n                    idx = content.find(title)\n                    before = content[max(0, idx-200):idx]\n                    link_match = re.search(r'href=\"([^\"]+)\"', before[::-1])\n                    if link_match:\n                        href = link_match.group(1)[::-1]\n                \n                announcements.append({\n                    \"title\": title,\n                    \"date\": date,\n                    \"url\": f\"http://hrss.xm.gov.cn/xygk/tzgg/\" if not href else href\n                })\n        \n        await browser.close()\n        return announcements\n\nasync def scrape_sti():\n    \"\"\"厦门科学技术局\"\"\"\n    print(\"抓取: 厦门科学技术局...\")\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        \n        urls = [\n            \"http://sti.xm.gov.cn/\",\n            \"http://sti.xm.gov.cn/zwgk/tzgg/\",\n            \"http://sti.xm.gov.cn/xw/gg/\"\n        ]\n        \n        content = \"\"\n        for url in urls:\n            await page.goto(url, timeout=30000)\n            await page.wait_for_timeout(3000)\n            content = await page.content()\n            if \"公告\" in content or \"通知\" in content:\n                print(f\"  找到公告页: {url}\")\n                break\n        \n        # 使用JS提取\n        text = await page.evaluate(\"\"\"() => {\n            const items = document.querySelectorAll('li, div.item, a.news-item, div.list-item, ul li a');\n            const result = [];\n            items.forEach(item => {\n                const text = item.innerText || '';\n                if (text.match(/\\\\d{4}-\\\\d{2}-\\\\d{2}/) && text.length > 10) {\n                    result.push(item.innerText);\n                }\n            });\n            return result.join('|||');\n        }\"\"\")\n        \n        announcements = []\n        for line in text.split('|||'):\n            match = re.search(r'(\\d{4}-\\d{2}-\\d{2})[\\s\\n]*([^\\n]{5,60})', line)\n            if match:\n                announcements.append({\n                    \"title\": match.group(2).strip(),\n                    \"date\": match.group(1),\n                    \"url\": \"\"\n                })\n        \n        await browser.close()\n        return announcements[:10]\n\nasync def scrape_fj_kjt():\n    \"\"\"福建省科技厅\"\"\"\n    print(\"抓取: 福建省科技厅...\")\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        await page.goto(\"http://kjt.fujian.gov.cn/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        content = await page.content()\n        \n        # 先看页面内容\n        text = await page.evaluate(\"\"\"() => {\n            const items = document.querySelectorAll('li, div.item, a.news-item, div.list-item, ul li a');\n            const result = [];\n            items.forEach(item => {\n                const text = item.innerText || '';\n                if (text.match(/\\\\d{4}-\\\\d{2}-\\\\d{2}/) && text.length > 10) {\n                    result.push(item.innerText);\n                }\n            });\n            return result.join('|||');\n        }\"\"\")\n        \n        announcements = []\n        for line in text.split('|||'):\n            match = re.search(r'(\\d{4}-\\d{2}-\\d{2})[\\s\\n]*([^\\n]{5,60})', line)\n            if match:\n                announcements.append({\n                    \"title\": match.group(2).strip(),\n                    \"date\": match.group(1),\n                    \"url\": \"\"\n                })\n        \n        await browser.close()\n        return announcements[:10]\n\nasync def main():\n    results = {}\n    results[\"厦门市人力资源和社会保障局\"] = await scrape_xm_hrss()\n    results[\"厦门科学技术局\"] = await scrape_sti()\n    results[\"福建省科技厅\"] = await scrape_fj_kjt()\n    \n    print(\"\\n=== 结果 ===\")\n    print(json.dumps(results, ensure_ascii=False, indent=2))\n    \n    return results\n\nif __name__ == \"__main__\":\n    asyncio.run(main())"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773476092205}}
