{"type":"message","id":"2d01b4ce","parentId":"72075ba9","timestamp":"2026-03-14T08:14:52.110Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"很好，页面加载成功了！内容是有的，而且我可以看到通知公告列表。看起来这个页面是关于\"信用公开\"而不是\"通知公告\"。URL可能是正确的，但内容是关于信用的。让我重新抓取，使用正确的选择器。\n\n从innerText可以看到公告列表，我需要用不同的方式提取。让我写一个更精确的脚本。\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"找到了！页面内容加载成功。让我用正确的方式提取公告：\n\n"},{"type":"toolCall","id":"call_06d7b55a4cb8450a8dab18f5","name":"exec","arguments":{"command":"python3 << 'EOF'\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport re\n\nasync def scrape_xm_hrss():\n    \"\"\"厦门市人力资源和社会保障局\"\"\"\n    print(\"抓取: 厦门市人力资源和社会保障局...\")\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        await page.goto(\"http://hrss.xm.gov.cn/xygk/tzgg/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        # 获取页面内容\n        content = await page.content()\n        \n        # 使用正则提取通知公告\n        # 格式: [日期] 标题\n        pattern = r'\\[(\\d{4}-\\d{2}-\\d{2})\\]\\s*([^\\n<]{5,80}?)</li>'\n        matches = re.findall(pattern, content)\n        \n        announcements = []\n        for date, title in matches[:10]:\n            title = title.strip()\n            if title and len(title) > 5:\n                # 尝试获取链接\n                href = \"\"\n                # 查找这个标题附近的链接\n                if title in content:\n                    idx = content.find(title)\n                    before = content[max(0, idx-200):idx]\n                    link_match = re.search(r'href=\"([^\"]+)\"', before[::-1])\n                    if link_match:\n                        href = link_match.group(1)[::-1]\n                \n                announcements.append({\n                    \"title\": title,\n                    \"date\": date,\n                    \"url\": href if href.startswith(\"http\") else f\"http://hrss.xm.gov.cn{href}\" if href.startswith(\"/\") else f\"http://hrss.xm.gov.cn/xygk/tzgg/{href}\"\n                })\n        \n        await browser.close()\n        return announcements\n\nasync def scrape_sti():\n    \"\"\"厦门科学技术局 - 尝试多个URL\"\"\"\n    print(\"抓取: 厦门科学技术局...\")\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        \n        # 尝试几个可能的URL\n        urls = [\n            \"http://sti.xm.gov.cn/\",\n            \"http://sti.xm.gov.cn/zwgk/tzgg/\",\n            \"http://sti.xm.gov.cn/xw/gg/\"\n        ]\n        \n        for url in urls:\n            await page.goto(url, timeout=30000)\n            await page.wait_for_timeout(3000)\n            content = await page.content()\n            \n            # 检查是否有通知公告\n            if \"公告\" in content or \"通知\" in content:\n                print(f\"  找到公告页: {url}\")\n                break\n        \n        # 直接提取innerText\n        text = await page.evaluate(\"\"\"() => {\n            // 尝试找到包含日期和标题的元素\n            const items = document.querySelectorAll('li, div.item, a.news-item');\n            const result = [];\n            items.forEach(item => {\n                const text = item.innerText || '';\n                if (text.match(/\\\\d{4}-\\\\d{2}-\\\\d{2}/) && text.length > 10) {\n                    result.push(item.innerHTML);\n                }\n            });\n            return result.join('\\\\n');\n        }\"\"\")\n        \n        announcements = []\n        for line in text.split('\\n'):\n            match = re.search(r'(\\d{4}-\\d{2}-\\d{2})[\\s\\n]*([^<\\n]{5,60})', line)\n            if match:\n                announcements.append({\n                    \"title\": match.group(2).strip(),\n                    \"date\": match.group(1),\n                    \"url\": \"\"\n                })\n        \n        await browser.close()\n        return announcements[:10]\n\nasync def scrape_fj_kjt():\n    \"\"\"福建省科技厅\"\"\"\n    print(\"抓取: 福建省科技厅...\")\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.goto(\"http://kjt.fujian.gov.cn/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        text = await page.evaluate(\"\"\"() => {\n            const items = document.querySelectorAll('li, div.item, a.news-item, div.list-item');\n            const result = [];\n            items.forEach(item => {\n                const text = item.innerText || '';\n                if (text.match(/\\\\d{4}-\\\\d{2}-\\\\d{2}/) && text.length > 10) {\n                    result.push(item.innerHTML);\n                }\n            });\n            return result.join('\\\\n');\n        }\"\"\")\n        \n        announcements = []\n        for line in text.split('\\n'):\n            match = re.search(r'(\\d{4}-\\d{2}-\\d{2})[\\s\\n]*([^<\\n]{5,60})', line)\n            if match:\n                announcements.append({\n                    \"title\": match.group(2).strip(),\n                    \"date\": match.group(1),\n                    \"url\": \"\"\n                })\n        \n        await browser.close()\n        return announcements[:10]\n\n# 运行\nresults = {}\nresults[\"厦门市人力资源和社会保障局\"] = await scrape_xm_hrss()\nresults[\"厦门科学技术局\"] = await scrape_sti()\nresults[\"福建省科技厅\"] = await scrape_fj_kjt()\n\nimport json\nprint(\"\\n=== 结果 ===\")\nprint(json.dumps(results, ensure_ascii=False, indent=2))\nEOF","timeout":120}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773476009555}}
