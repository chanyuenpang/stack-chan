{"type":"message","id":"14d245e3","parentId":"55b54274","timestamp":"2026-03-14T08:22:09.116Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"找到了福建科技厅的正确URL是 http://kjt.fujian.gov.cn/xxgk/tzgg/\n\n现在让我整合所有结果，生成最终的 Markdown 文件。\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"找到了！现在让我生成完整的结果文件：\n\n"},{"type":"toolCall","id":"call_1bc41d19584741a6ad2dd94f","name":"exec","arguments":{"command":"python3 << 'EOF'\nimport asyncio\nfrom playwright.async_api import async_playwright\nimport json\nimport os\n\nasync def scrape_all():\n    results = {}\n    \n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        page = await browser.new_page()\n        \n        # 1. 厦门人社局\n        print(\"抓取: 厦门市人力资源和社会保障局...\")\n        await page.goto(\"http://hrss.xm.gov.cn/xygk/tzgg/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        items = await page.evaluate(\"\"\"() => {\n            const lis = document.querySelectorAll('li.b-free-read-leaf');\n            const result = [];\n            lis.forEach(li => {\n                const a = li.querySelector('a');\n                const span = li.querySelector('span');\n                if (a && span) {\n                    const dateText = span.innerText.trim().replace('[', '').replace(']', '');\n                    result.push({\n                        title: a.innerText.trim(),\n                        date: dateText,\n                        href: a.href\n                    });\n                }\n            });\n            return result;\n        }\"\"\")\n        results[\"厦门市人力资源和社会保障局\"] = items[:10]\n        \n        # 2. 厦门科技局 - 使用正确的URL\n        print(\"抓取: 厦门科学技术局...\")\n        await page.goto(\"http://sti.xm.gov.cn/xxgk/tzgg/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        items = await page.evaluate(\"\"\"() => {\n            const lis = document.querySelectorAll('li');\n            const result = [];\n            lis.forEach(li => {\n                const text = li.innerText || '';\n                const a = li.querySelector('a');\n                if (text.match(/\\\\d{4}-\\\\d{2}-\\\\d{2}/) && a) {\n                    const match = text.match(/(.+?)(\\\\d{4}-\\\\d{2}-\\\\d{2})/);\n                    if (match) {\n                        result.push({\n                            title: match[1].trim(),\n                            date: match[2],\n                            href: a.href\n                        });\n                    }\n                }\n            });\n            return result;\n        }\"\"\")\n        results[\"厦门科学技术局\"] = items[:10]\n        \n        # 3. 福建科技厅\n        print(\"抓取: 福建省科技厅...\")\n        await page.goto(\"http://kjt.fujian.gov.cn/xxgk/tzgg/\", timeout=30000)\n        await page.wait_for_timeout(3000)\n        \n        items = await page.evaluate(\"\"\"() => {\n            const lis = document.querySelectorAll('li');\n            const result = [];\n            lis.forEach(li => {\n                const text = li.innerText || '';\n                const a = li.querySelector('a');\n                if (text.match(/\\\\d{4}-\\\\d{2}-\\\\d{2}/) && a && text.length > 10 && text.length < 150) {\n                    const match = text.match(/(.+?)(\\\\d{4}-\\\\d{2}-\\\\d{2})/);\n                    if (match && match[1].trim().length > 5) {\n                        result.push({\n                            title: match[1].trim(),\n                            date: match[2],\n                            href: a.href\n                        });\n                    }\n                }\n            });\n            return result;\n        }\"\"\")\n        results[\"福建省科技厅\"] = items[:10]\n        \n        await browser.close()\n    \n    return results\n\nresults = asyncio.run(scrape_all())\n\n# 生成 Markdown 格式\nmd_content = f\"\"\"# 公告列表 - 2026-03-14\n\n抓取时间: 2026-03-14\n\n---\n\n## 厦门市人力资源和社会保障局\n\n| 标题 | 发布日期 | 链接 |\n|------|----------|------|\n\"\"\"\n\nfor item in results[\"厦门市人力资源和社会保障局\"]:\n    md_content += f\"| {item['title']} | {item['date']} | [查看]({item['href']}) |\\n\"\n\nmd_content += f\"\"\"\n\n## 厦门科学技术局\n\n| 标题 | 发布日期 | 链接 |\n|------|----------|------|\n\"\"\"\n\nfor item in results[\"厦门科学技术局\"]:\n    md_content += f\"| {item['title']} | {item['date']} | [查看]({item['href']}) |\\n\"\n\nmd_content += f\"\"\"\n\n## 福建省科技厅\n\n| 标题 | 发布日期 | 链接 |\n|------|----------|------|\n\"\"\"\n\nfor item in results[\"福建省科技厅\"]:\n    md_content += f\"| {item['title']} | {item['date']} | [查看]({item['href']}) |\\n\"\n\n# 确保目录存在\noutput_dir = os.path.expanduser(\"~/.openclaw/workspace/skills/adaptive-announcement-scraper/.learnings\")\nos.makedirs(output_dir, exist_ok=True)\n\n# 写入文件\noutput_path = os.path.join(output_dir, \"公告列表-2026-03-14.md\")\nwith open(output_path, 'w', encoding='utf-8') as f:\n    f.write(md_content)\n\nprint(f\"✅ 已保存到: {output_path}\")\nprint(f\"\\n共抓取:\")\nprint(f\"  - 厦门人社局: {len(results['厦门市人力资源和社会保障局'])} 条\")\nprint(f\"  - 厦门科技局: {len(results['厦门科学技术局'])} 条\")\nprint(f\"  - 福建科技厅: {len(results['福建省科技厅'])} 条\")\nEOF","timeout":90}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773476456363}}
