ho \"   ❌ WolframAlpha - 不可用\"\nfi","timeout":120}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773464165876}}
