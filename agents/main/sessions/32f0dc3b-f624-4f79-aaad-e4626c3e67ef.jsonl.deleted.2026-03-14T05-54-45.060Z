{"type":"message","id":"58a1bea6","parentId":"8f9d2e45","timestamp":"2026-03-14T04:55:52.159Z","message":{"role":"assistant","content":[{"type":"text","text":"国内搜索引擎测试完成！现在测试国际搜索引擎："},{"type":"toolCall","id":"exec:6","name":"exec","arguments":{"command":"# 测试国际搜索引擎 - 第1批：Google, Google HK, DuckDuckGo, Yahoo, Startpage\n\necho \"=== 测试国际搜索引擎 ===\"\necho \"\"\n\n# 1. Google\necho \"1. 测试 Google...\"\nGOOGLE_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://www.google.com/search?q=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$GOOGLE_RESULT\" ] && echo \"$GOOGLE_RESULT\" | grep -q \"Google\\|google\"; then\n  echo \"   ✅ Google - 可用\"\nelse\n  echo \"   ❌ Google - 不可用\"\nfi\n\n# 2. Google HK\necho \"2. 测试 Google HK...\"\nGOOGLEHK_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://www.google.com.hk/search?q=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$GOOGLEHK_RESULT\" ] && echo \"$GOOGLEHK_RESULT\" | grep -q \"Google\\|google\"; then\n  echo \"   ✅ Google HK - 可用\"\nelse\n  echo \"   ❌ Google HK - 不可用\"\nfi\n\n# 3. DuckDuckGo\necho \"3. 测试 DuckDuckGo...\"\nDDG_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://duckduckgo.com/html/?q=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$DDG_RESULT\" ] && echo \"$DDG_RESULT\" | grep -q \"DuckDuckGo\\|duckduckgo\\|result\"; then\n  echo \"   ✅ DuckDuckGo - 可用\"\nelse\n  echo \"   ❌ DuckDuckGo - 不可用\"\nfi\n\n# 4. Yahoo\necho \"4. 测试 Yahoo...\"\nYAHOO_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://search.yahoo.com/search?p=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$YAHOO_RESULT\" ] && echo \"$YAHOO_RESULT\" | grep -q \"Yahoo\\|yahoo\\|search\"; then\n  echo \"   ✅ Yahoo - 可用\"\nelse\n  echo \"   ❌ Yahoo - 不可用\"\nfi\n\n# 5. Startpage\necho \"5. 测试 Startpage...\"\nSTARTPAGE_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://www.startpage.com/sp/search?query=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$STARTPAGE_RESULT\" ] && echo \"$STARTPAGE_RESULT\" | grep -q \"Startpage\\|startpage\\|result\"; then\n  echo \"   ✅ Startpage - 可用\"\nelse\n  echo \"   ❌ Startpage - 不可用\"\nfi","timeout":150}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773464120340}}
