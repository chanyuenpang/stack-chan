{"type":"message","id":"62e12b32","parentId":"5cc78bcf","timestamp":"2026-03-14T04:55:17.466Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"exec:5","name":"exec","arguments":{"command":"# 测试国内搜索引擎 - 第2批：Sogou, WeChat, Toutiao, Jisilu\n\necho \"=== 继续测试国内搜索引擎 ===\"\necho \"\"\n\n# 5. Sogou\necho \"5. 测试 Sogou...\"\nSOGOU_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://sogou.com/web?query=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$SOGOU_RESULT\" ] && echo \"$SOGOU_RESULT\" | grep -q \"搜狗\\|sogou\"; then\n  echo \"   ✅ Sogou - 可用\"\nelse\n  echo \"   ❌ Sogou - 不可用\"\nfi\n\n# 6. WeChat\necho \"6. 测试 WeChat...\"\nWECHAT_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://wx.sogou.com/weixin?type=2&query=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$WECHAT_RESULT\" ] && echo \"$WECHAT_RESULT\" | grep -q \"微信\\|搜狗\"; then\n  echo \"   ✅ WeChat - 可用\"\nelse\n  echo \"   ❌ WeChat - 不可用\"\nfi\n\n# 7. Toutiao\necho \"7. 测试 Toutiao...\"\nTOUTIAO_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://so.toutiao.com/search?keyword=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$TOUTIAO_RESULT\" ] && echo \"$TOUTIAO_RESULT\" | grep -q \"头条\\|toutiao\"; then\n  echo \"   ✅ Toutiao - 可用\"\nelse\n  echo \"   ❌ Toutiao - 不可用\"\nfi\n\n# 8. Jisilu\necho \"8. 测试 Jisilu...\"\nJISILU_RESULT=$(curl -sL --max-time 15 --connect-timeout 10 \\\n  -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\" \\\n  \"https://www.jisilu.cn/explore/?keyword=OpenAI\" 2>&1)\nif [ $? -eq 0 ] && [ -n \"$JISILU_RESULT\" ] && echo \"$JISILU_RESULT\" | grep -q \"集思录\\|jisilu\"; then\n  echo \"   ✅ Jisilu - 可用\"\nelse\n  echo \"   ❌ Jisilu - 不可用\"\nfi","timeout":120}}],"a