7\", \"中国进出口银行AI大模型一体机采购项目-招标公告\", \"2026-03-13\"),\n    (\"8\", \"【海棠·华府】项目销售服务采购（二次）-中标结果...\", \"2026-03-13\"),\n    (\"9\", \"中国进出口银行吉林省分行2026年至2027年度押...\", \"2026-03-13\"),\n    (\"10\", \"基层一线城市运行服务保障人员上下铺采购-结果公告\", \"2026-03-13\"),\n    (\"11\", \"通勤车服务采购项目【重新招标】【重新招标】-结果公告\", \"2026-03-13\"),\n    (\"12\", \"KT项目算力租赁（二期）-结果公告\", \"2026-03-13\"),\n    (\"13\", \"榆能横山电厂二期2×1000MW机组项目（第5.5...）\", \"2026-03-13\"),\n    (\"14\", \"2025年中国联通辽宁省分公司政企线上综合服务运营...\", \"2026-03-13\"),\n    (\"15\", \"北京市海淀医院急诊医学科改造项目（监理）-成交公告\", \"2026-03-13\"),\n    (\"16\", \"北京市海淀医院急诊医学科改造项目（工程检测）-成交公告\", \"2026-03-13\"),\n    (\"17\", \"电车分公司2026年空调移机及维修保养服务采购项目...\", \"2026-03-13\"),\n    (\"18\", \"2026年中国联通朝阳市分公司浪马轮胎工业互联网设...\", \"2026-03-13\"),\n    (\"19\", \"2026年中国联通阜新市分公司绿电智算中心新建工程...\", \"2026-03-13\"),\n    (\"20\", \"云南中烟工业有限责任公司营销中心2025-2028...\", \"2026-03-13\"),\n    (\"21\", \"白山市中心医院银医合作项目-中标候选人公示\", \"2026-03-13\"),\n    (\"22\", \"天津力神聚元新能源科技有限公司聚合物电池多极耳焊接...\", \"2026-03-13\"),\n    (\"23\", \"2026年中国联通盘锦市分公司低空无人机采购项目...\", \"2026-03-12\"),\n    (\"24\", \"东莞市水务环境投资控股集团管网有限公司2026年防...\", \"2026-03-12\"),\n    (\"25\", \"2026年中国联通葫芦岛市分公司建昌县四家医院服务...\", \"2026-03-12\"),\n    (\"26\", \"广东省技师学院学生宿舍消防设施更换维保项目（第三次）\", \"2026-03-12\"),\n    (\"27\", \"2025年中国联通锦州市分公司和美家园小区通讯与智...\", \"2026-03-12\"),\n    (\"28\", \"2025年中国联通锦州市分公司和美家园小区通讯与智...\", \"2026-03-12\"),\n]\n\nfor i, (num, title, date) in enumerate(cntcitc_data):\n    row = table1.rows[i+1].cells\n    row[0].text = num\n    row[1].text = title\n    row[2].text = date\n\n# ===================== 第二部分：厦门火炬高新区 =====================\ndoc.add_heading('二、厦门火炬高新区（5条）', level=1)\n\ntable2 = doc.add_table(rows=6, cols=3)\ntable2.style = 'Table Grid'\n\n# 表头\nheader_cells2 = table2.rows[0].cells\nheader_cells2[0].text = '序号'\nheader_cells2[1].text = '标题'\nheader_cells2[2].text = '发布日期'\n\nfor cell in header_cells2:\n    cell.paragraphs[0].runs[0].bold = True\n\n# 火炬高新区数据\ntorch_data = [\n    (\"1\", \"厦门火炬高新区智能制造服务商认定与退出管理工作机制\", \"2026-03-12\"),\n    (\"2\", \"厦门火炬高新区管委会关于2月份（总第69期）新引进人才生活补贴拟发放人员名单的公示\", \"2026-03-12\"),\n    (\"3\", \"厦门火炬高新区管委会关于组织申报2026年专精特新工业企业、中小企业数字化转型试点企业技术改造补助资金的通知\", \"2026-03-03\"),\n    (\"4\", \"厦门火炬高新区管委会关于开展2025年度\"火炬协同创新主体\"资金兑付工作的通知\", \"2026-03-03\"),\n    (\"5\", \"厦门火炬高新区管委会关于组织申报2026年厦门市工业企业工业固投补助资金的通知\", \"2026-03-02\"),\n]\n\nfor i, (num, title, date) in enumerate(torch_data):\n    row = table2.rows[i+1].cells\n    row[0].text = num\n    row[1].text = title\n    row[2].text = date\n\n# ===================== 第三部分：思明区科技和工信局 =====================\ndoc.add_heading('三、厦门市思明区科技和工信局（13条）', level=1)\n\ntable3 = doc.add_table(rows=14, cols=3)\ntable3.style = 'Table Grid'\n\n# 表头\nheader_cells3 = table3.rows[0].cells\nheader_cells3[0].text = '序号'\nheader_cells3[1].text = '标题'\nheader_cells3[2].text = '发布日期'\n\nfor cell in header_cells3:\n    cell.paragraphs[0].runs[0].bold = True\n\n# 思明区科技局数据\nsiming_data = [\n    (\"1\", \"厦门市思明区科技和工信局机构职能目录表\", \"2025-12-23\"),\n    (\"2\", \"2026年厦门市思明区政务服务保障中心预算说明\", \"2026-01-30\"),\n    (\"3\", \"2026年厦门市思明区信息中心预算说明\", \"2026-01-30\"),\n    (\"4\", \"2026年厦门市思明区企业服务中心预算说明\", \"2026-01-30\"),\n    (\"5\", \"2026年厦门市思明区科技和工信局部门预算说明\", \"2026-01-30\"),\n    (\"6\", \"2026年厦门市思明区科技和工信局预算说明\", \"2026-01-30\"),\n    (\"7\", \"2024年厦门市思明区信息中心项目支出绩效自评\", \"2025-05-30\"),\n    (\"8\", \"一图读懂《思明区先进制造业高质量发展若干措施》\", \"2026-03-05\"),\n    (\"9\", \"关于《思明区先进制造业高质量发展若干措施》的政策解读\", \"2026-03-05\"),\n    (\"10\", \"厦门市思明区科技和工信局关于印发思明区先进制造业高质量发展若干措施的通知\", \"2026-03-05\"),\n    (\"11\", \"关于拟认定永嘉（厦门）工业有限公司云顶中路505、515号项目为低效工业用地的公示\", \"2026-02-28\"),\n    (\"12\", \"关于拟认定厦门光莆电子股份有限公司光莆电子大厦项目为低效工业用地的公示\", \"2026-02-28\"),\n    (\"13\", \"思明区科技和工信局关于《思明区促进新一代人工智能产业发展若干措施（修订）》（意见征求稿）公开征求意见的通知\", \"2026-02-14\"),\n]\n\nfor i, (num, title, date) in enumerate(siming_data):\n    row = table3.rows[i+1].cells\n    row[0].text = num\n    row[1].text = title\n    row[2].text = date\n\n# 统计信息\ndoc.add_paragraph()\nsummary = doc.add_paragraph()