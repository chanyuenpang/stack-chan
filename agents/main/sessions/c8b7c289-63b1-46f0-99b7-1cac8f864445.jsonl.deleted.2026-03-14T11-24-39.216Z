k; height: 62px; width: 335px; margin:0 auto; background: #56c3f1; border-radius: 5px; font-size: 36px; color: #fff; text-align: center; line-height: 62px;  }\n    .mod a:hover{ opacity: 0.8; filter:alpha(opacity=80); }\n    @media screen and (max-width:1024px){\n        .mod{width: 300px; margin-left: -150px;}\n        .mod .im img{ width: 300px; }\n        .mod p{ font-size: 18px; line-height: 32px; }\n        .mod a{ width: 260px; }\n    }\n    @media screen and (max-width:640px){\n        .mod{width: 260px; margin-left: -130px;}\n        .mod a{ line-height: 50px; height: 50px; font-size: 28px; }\n    }\n</style>\n\n</head>\n\n<body>\n    <div class=\"mod\">\n\n        <div class=\"im\"><img src=\"data:image/png;base64,\" height=\"190\" width=\"462\"></div>\n        <p>sorry 您所查看的页面不存在了<br>您可以通过以下方式继续访问······</p>\n        <a href=\"/\">返回首页</a>\n    </div>\n\n\n</body></html>"}],"isError":false,"timestamp":1773483915634}}
