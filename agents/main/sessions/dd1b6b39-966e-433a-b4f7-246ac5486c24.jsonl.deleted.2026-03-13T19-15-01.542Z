{"type":"message","id":"dd04735d","parentId":"c8c2a24d","timestamp":"2026-03-13T18:14:59.543Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"\nPerfect, found the crawler files! Let's first read the main crawler file to understand the current implementation, then the config (if any) and then fix the issues one by one.\nFirst, read crawler.py:\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_87s9izhw1h7i2py8zz8bywkm","name":"read","arguments":{"path":"/home/yankeeting/.openclaw/workspace/projects/daily-news-crawler/scripts/crawler.py"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773425697676}}
{"type":"message","id":"df6af2bd","parentId":"dd04735d","timestamp":"2026-03-13T18:14:59.549Z","message":{"role":"toolResult","toolCallId":"call_87s9izhw1h7i2py8zz8bywkm","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\n政府网站新闻抓取脚本\n每日抓取 40 个政府网站的新闻和政策\n\"\"\"\n\nimport asyncio\nimport json\nimport re\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom typing import List, Dict, Optional\nfrom urllib.parse import urljoin, urlparse\n\nfrom playwright.async_api import async_playwright, Page\n\n# 配置\nCONFIG_DIR = Path(\"~/.openclaw/workspace/projects/daily-news-crawler/config\").expanduser()\nOUTPUT_DIR = Path(\"~/DailyReports\").expanduser()\nDAYS_BACK = 7  # 抓取最近 7 天的内容\n\nclass NewsCrawler:\n    def __init__(self):\n        self.results: List[Dict] = []\n        self.errors: List[Dict] = []\n        \n    async def crawl_site(self, page: Page, site_config: Dict) -> List[Dict]:\n        \"\"\"抓取单个网站的新闻\"\"\"\n        url = site_config[\"url\"]\n        name = site_config[\"name\"]\n        selectors = site_config.get(\"selector\", {})\n        \n        print(f\"[INFO] 正在抓取: {name} ({url})\")\n        \n        try:\n            # 访问页面\n            await page.goto(url, wait_until=\"networkidle\", timeout=30000)\n            await page.wait_for_load_state(\"domcontentloaded\")\n            \n            # 等待内容加载\n            list_selector = selectors.get(\"list\", \".news-list li, .list-item\")\n            try:\n                await page.wait_for_selector(list_selector, timeout=10000)\n            except:\n                print(f\"[WARN] {name}: 未找到列表元素，尝试备用选择器\")\n                # 尝试其他常见选择器\n                for backup in [\".news-item\", \".list-news li\", \".content-list li\", \"tr\"]:\n                    try:\n                        await page.wait_for_selector(backup, timeout=5000)\n                        list_selector = backup\n                        print(f\"[INFO] {name}: 使用备用选择器 {backup}\")\n                        break\n                    except:\n                        continue\n            \n            # 提取新闻列表\n            items = await page.query_selector_all(list_selector)\n            print(f\"[INFO] {name}: 找到 {len(items)} 个条目\")\n            \n            news_list = []\n            for item in items[:20]:  # 最多取前 20 条\n                try:\n                    # 提取标题\n                    title_elem = await item.query_selector(selectors.get(\"title\", \".title, a, .news-title\"))\n                    if not title_elem:\n                        title_elem = item  # 如果找不到，就用 item 本身\n                    \n                    title = await title_elem.text_content()\n                    title = title.strip() if title else \"\"\n                    \n                    if not title or len(title) < 5:\n                        continue\n                    \n                    # 提取链接\n                    link_elem = await item.query_selector(\"a\")\n                    if link_elem:\n                        href = await link_elem.get_attribute(\"href\")\n                        if href:\n                            link = urljoin(url, href)\n                        else:\n                            link = url\n                    else:\n                        link = url\n                    \n                    # 提取日期\n                    date = \"\"\n                    date_elem = await item.query_selector(selectors.get(\"date\", \".date, .time, .news-date\"))\n                    if date_elem:\n                        date_text = await date_elem.text_content()\n                        date = self.parse_date(date_text.strip())\n                    \n                    if not date:\n                        # 如果没有日期，使用当前日期（假设是最新内容）\n                        date = datetime.now().strftime(\"%Y-%m-%d\")\n                    \n                    # 检查是否在指定时间范围内\n                    try:\n                        item_date = datetime.strptime(date, \"%Y-%m-%d\")\n                        cutoff_date = datetime.now() - timedelta(days=DAYS_BACK)\n                        if item_date < cutoff_date:\n                            continue  # 跳过旧内容\n                    except:\n                        pass\n                    \n                    # 提取摘要（如果有）\n                    summary = \"\"\n                    summary_elem = await item.query_selector(selectors.get(\"summary\", \".summary, .content, .news-content\"))\n                    if summary_elem:\n                        summary_text = await summary_elem.text_content()\n                        summary = summary_text.strip()[:100] + \"...\" if len(summary_text) > 100 else summary_text.strip()\n                    \n                    if not summary:\n                        summary = title[:50] + \"...\" if len(title) > 50 else title\n                    \n                    news_item = {\n                        \"site_name\": name,\n                        \"site_url\": url,\n                        \"category\": site_config.get(\"category\", \"其他\"),\n                        \"title\": title,\n                        \"url\": link,\n                        \"date\": date,\n                        \"summary\": summary,\n                        \"crawled_at\": datetime.now().isoformat()\n                    }\n                    \n                    news_list.append(news_item)\n                    \n                except Exception as e:\n                    print(f\"[WARN] {name}: 解析条目失败: {str(e)}\")\n                    continue\n            \n            print(f\"[INFO] {name}: 成功提取 {len(news_list)} 条新闻\")\n            return news_list\n            \n        except Exception as e:\n            error_msg = f\"[ERROR] {name}: 抓取失败 - {str(e)}\"\n            print(error_msg)\n            self.errors.append({\n                \"site_name\": name,\n                \"site_url\": url,\n                \"error\": str(e),\n                \"timestamp\": datetime.now().isoformat()\n            })\n            return []\n    \n    def parse_date(self, date_text: str) -> str:\n        \"\"\"解析各种日期格式\"\"\"\n        date_text = date_text.strip()\n        \n        # 常见日期格式\n        patterns = [\n            (r\"(\\d{4})-(\\d{2})-(\\d{2})\", \"%Y-%m-%d\"),\n            (r\"(\\d{4})/(\\d{2})/(\\d{2})\", \"%Y/%m/%d\"),\n            (r\"(\\d{4})年(\\d{2})月(\\d{2})日\", \"%Y年%m月%d日\"),\n            (r\"(\\d{2})-(\\d{2})\", \"%m-%d\"),  # 只有月日，假设今年\n        ]\n        \n        for pattern, fmt in patterns:\n            match = re.search(pattern, date_text)\n            if match:\n                try:\n                    if len(match.groups()) == 2:  # 只有月日\n                        year = datetime.now().year\n                        month, day = match.groups()\n                        return f\"{year}-{month}-{day}\"\n                    else:\n                        return match.group(0).replace(\"/\", \"-\").replace(\"年\", \"-\").replace(\"月\", \"-\").replace(\"日\", \"\")\n                except:\n                    continue\n        \n        return \"\"\n    \n    async def run(self):\n        \"\"\"运行抓取任务\"\"\"\n        print(\"=\" * 60)\n        print(f\"[INFO] 开始抓取任务 - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n        print(\"=\" * 60)\n        \n        # 读取配置\n        config_file = CONFIG_DIR / \"urls.json\"\n        if not config_file.exists():\n            print(f\"[ERROR] 配置文件不存在: {config_file}\")\n            return []\n        \n        with open(config_file, \"r\", encoding=\"utf-8\") as f:\n            config = json.load(f)\n        \n        sites = config.get(\"sources\", [])\n        print(f\"[INFO] 共 {len(sites)} 个网站需要抓取\")\n        \n        # 使用 Playwright 抓取\n        async with async_playwright() as p:\n            browser = await p.chromium.launch(headless=True)\n            \n            # 串行抓取（避免并发过大）\n            for i, site in enumerate(sites, 1):\n                print(f\"\\n[{i}/{len(sites)}] \", end=\"\")\n                \n                page = await browser.new_page()\n                \n                try:\n                    news = await self.crawl_site(page, site)\n                    self.results.extend(news)\n                except Exception as e:\n                    print(f\"[ERROR] 未捕获的异常: {str(e)}\")\n                \n                await page.close()\n            \n            await browser.close()\n        \n        # 输出统计\n        print(\"\\n\" + \"=\" * 60)\n        print(f\"[INFO] 抓取完成 - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n        print(f\"[INFO] 成功抓取: {len(self.results)} 条新闻\")\n        print(f\"[INFO] 失败站点: {len(self.errors)} 个\")\n        print(\"=\" * 60)\n        \n        return self.results\n\n\nasync def main():\n    \"\"\"主函数\"\"\"\n    crawler = NewsCrawler()\n    results = await crawler.run()\n    \n    # 输出结果到文件（用于调试）\n    output_file = OUTPUT_DIR / f\"crawl_result_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json\"\n    with open(output_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump({\n            \"results\": results,\n            \"errors\": crawler.errors,\n            \"timestamp\": datetime.now().isoformat()\n        }, f, ensure_ascii=False, indent=2)\n    \n    print(f\"[INFO] 结果已保存到: {output_file}\")\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n"}],"isError":false,"timestamp":1773425699547}}
{"type":"message","id":"6bb43730","parentId":"df6af2bd","timestamp":"2026-03-13T18:15:02.027Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"\nGreat, now let's read the urls config file to see the sites, especially the Xiamen Construction Bureau one that has DNS issues. Also check if we need to update the selectors for the updated DOM structures.\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_dtuikkliecasar9pzdlvxqbr","name":"read","arguments":{"path":"/home/yankeeting/.openclaw/workspace/projects/daily-news-crawler/config/urls.json"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773425699549}}
{"type":"message","id":"4a08d877","parentId":"6bb43730","timestamp":"2026-03-13T18:15:02.034Z","message":{"role":"toolResult","toolCallId":"call_dtuikkliecasar9pzdlvxqbr","toolName":"read","content":[{"type":"text","text":"{\n  \"version\": \"1.0\",\n  \"description\": \"政府网站新闻政策监控列表\",\n  \"lastUpdated\": \"2025-03-13\",\n  \"sources\": [\n    {\n      \"id\": \"xm_hrss\",\n      \"name\": \"厦门市人力资源和社会保障局\",\n      \"category\": \"社保人社\",\n      \"url\": \"http://hrss.xm.gov.cn/xygk/tzgg/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_dpc\",\n      \"name\": \"厦门市发展和改革委员会\",\n      \"category\": \"发改政策\",\n      \"url\": \"http://dpc.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item, .news_item\",\n        \"title\": \".title, a, .news_title\",\n        \"date\": \".date, .time, .news_date\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_sti\",\n      \"name\": \"厦门科学技术局\",\n      \"category\": \"科技政策\",\n      \"url\": \"http://sti.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"most\",\n      \"name\": \"中华人民共和国科学技术部\",\n      \"category\": \"国家科技政策\",\n      \"url\": \"http://www.most.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item, .content-list li\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_sme\",\n      \"name\": \"厦门市中小企业服务中心\",\n      \"category\": \"中小企业服务\",\n      \"url\": \"http://www.xmsme.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"miit\",\n      \"name\": \"中华人民共和国工业和信息化部\",\n      \"category\": \"国家工信政策\",\n      \"url\": \"http://www.miit.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item, .content-list li\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"ndrc\",\n      \"name\": \"中华人民共和国国家发展和改革委员会\",\n      \"category\": \"国家发改政策\",\n      \"url\": \"http://www.ndrc.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"mnr\",\n      \"name\": \"自然资源部门户网站\",\n      \"category\": \"自然资源政策\",\n      \"url\": \"http://www.mnr.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"fj_kjt\",\n      \"name\": \"福建省科技厅\",\n      \"category\": \"省级科技政策\",\n      \"url\": \"http://kjt.fujian.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_jsj\",\n      \"name\": \"厦门市建设局\",\n      \"category\": \"建设政策\",\n      \"url\": \"http://js.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_gxj\",\n      \"name\": \"厦门市工业和信息化局\",\n      \"category\": \"工信政策\",\n      \"url\": \"http://gxj.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date