n\": \"keep-alive\",\n+ 36     \"Upgrade-Insecure-Requests\": \"1\",\n+ 37     \"Sec-Fetch-Dest\": \"document\",\n+ 38     \"Sec-Fetch-Mode\": \"navigate\",\n+ 39     \"Sec-Fetch-Site\": \"none\",\n+ 40     \"Sec-Fetch-User\": \"?1\",\n+ 41     \"Cache-Control\": \"max-age=0\"\n+ 42 }\n  21 \n  22 class NewsCrawler:\n  23     def __init__(self):\n  24         self.results: List[Dict] = []\n     ...","firstChangedLine":10},"isError":false,"timestamp":1773425727035}}
