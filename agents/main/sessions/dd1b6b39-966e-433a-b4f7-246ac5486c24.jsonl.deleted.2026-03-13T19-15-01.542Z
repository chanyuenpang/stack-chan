{"type":"message","id":"774bd4aa","parentId":"f44f4b86","timestamp":"2026-03-13T18:15:44.986Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"\nNow let's update the crawl_site method to add retries, better headers, dynamic content loading (scroll down), and random delays to avoid rate limits:\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_bbzipjv3f25yyldsgtengc6q","name":"edit","arguments":{"path":"/home/yankeeting/.openclaw/workspace/projects/daily-news-crawler/scripts/crawler.py","oldText":"    async def crawl_site(self, page: Page, site_config: Dict) -> List[Dict]:\n        \"\"\"抓取单个网站的新闻\"\"\"\n        url = site_config[\"url\"]\n        name = site_config[\"name\"]\n        selectors = site_config.get(\"selector\", {})\n        \n        print(f\"[INFO] 正在抓取: {name} ({url})\")\n        \n        try:\n            # 访问页面\n            await page.goto(url, wait_until=\"networkidle\", timeout=30000)\n            await page.wait_for_load_state(\"domcontentloaded\")\n            \n            # 等待内容加载\n            list_selector = selectors.get(\"list\", \".news-list li, .list-item\")\n            try:\n                await page.wait_for_selector(list_selector, timeout=10000)\n            except:\n                print(f\"[WARN] {name}: 未找到列表元素，尝试备用选择器\")\n                # 尝试其他常见选择器\n                for backup in [\".news-item\", \".list-news li\", \".content-list li\", \"tr\"]:\n                    try:\n                        await page.wait_for_selector(backup, timeout=5000)\n                        list_selector = backup\n                        print(f\"[INFO] {name}: 使用备用选择器 {backup}\")\n                        break\n                    except:\n                        continue","newText":"    async def crawl_site(self, page: Page, site_config: Dict) -> List[Dict]:\n        \"\"\"抓取单个网站的新闻\"\"\"\n        url = site_config[\"url\"]\n        name = site_config[\"name\"]\n        selectors = site_config.get(\"selector\", {})\n        \n        print(f\"[INFO] 正在抓取: {name} ({url})\")\n        \n        # 设置随机UA和请求头\n        user_agent = random.choice(USER_AGENTS)\n        await page.set_extra_http_headers({\n            \"User-Agent\": user_agent,\n            **REQUEST_HEADERS\n        })\n        \n        # 重试机制\n        for retry in range(MAX_RETRIES):\n            try:\n                # 随机延迟，避免访问频率过高\n                await asyncio.sleep(random.uniform(1, 3))\n                \n                # 访问页面\n                await page.goto(url, wait_until=\"networkidle\", timeout=30000)\n                await page.wait_for_load_state(\"domcontentloaded\")\n                \n                # 滚动页面触发懒加载\n                await page.evaluate(\"window.scrollTo(0, document.body.scrollHeight)\")\n                await asyncio.sleep(2)\n                await page.evaluate(\"window.scrollTo(0, 0)\")\n                await asyncio.sleep(1)\n                \n                # 等待内容加载\n                list_selector = selectors.get(\"list\", \".news-list li, .list-item, .list li, .news-item, .item\")\n                try:\n                    await page.wait_for_selector(list_selector, timeout=10000)\n                    break\n                except:\n                    if retry == MAX_RETRIES - 1:\n                        print(f\"[WARN] {name}: 未找到列表元素，尝试备用选择器\")\n                        # 尝试其他常见选择器\n                        for backup in [\".news-item\", \".list-news li\", \".content-list li\", \"tr\", \".article-item\", \".list-item-wrap\"]:\n                            try:\n                                await page.wait_for_selector(backup, timeout=5000)\n                                list_selector = backup\n                                print(f\"[INFO] {name}: 使用备用选择器 {backup}\")\n                                break\n                            except:\n                                continue\n                    else:\n                        print(f\"[INFO] {name}: 第 {retry + 1} 次重试...\")\n                        await asyncio.sleep(random.uniform(2, 5))\n                        continue\n            except Exception as e:\n                if retry == MAX_RETRIES - 1:\n                    raise e\n                print"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"aborted","timestamp":1773425727038,"errorMessage":"Request was aborted"}}
