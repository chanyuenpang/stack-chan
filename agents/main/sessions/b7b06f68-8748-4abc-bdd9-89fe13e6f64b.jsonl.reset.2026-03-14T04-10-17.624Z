/\n+298 async function uploadFileFeishuInternal(params: {\n+299   cfg: ClawdbotConfig;\n 250   file: Buffer | string; // Buffer or file path\n 251   fileName: string;\n 252   fileType: \"opus\" | \"mp4\" | \"pdf\" | \"doc\" | \"xls\" | \"ppt\" | \"stream\";\n 253   duration?: number; // Required for audio/video files, in milliseconds\n     ...","firstChangedLine":247},"isError":false,"timestamp":1773425054962}}
