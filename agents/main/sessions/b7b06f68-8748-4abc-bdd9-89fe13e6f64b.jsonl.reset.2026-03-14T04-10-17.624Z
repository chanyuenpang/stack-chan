{"type":"message","id":"9fd50563","parentId":"57f2f2e3","timestamp":"2026-03-13T18:03:36.791Z","message":{"role":"toolResult","toolCallId":"call_evcheui4dbfeeh5fvkd1zoky","toolName":"read","content":[{"type":"text","text":"  file: Buffer | string; // Buffer or file path\n  fileName: string;\n  fileType: \"opus\" | \"mp4\" | \"pdf\" | \"doc\" | \"xls\" | \"ppt\" | \"stream\";\n  duration?: number; // Required for audio/video files, in milliseconds\n  accountId?: string;\n}): Promise<UploadFileResult> {\n  const { cfg, file, fileName, fileType, duration, accountId } = params;\n  const account = resolveFeishuAccount({ cfg, accountId });\n  if (!account.configured) {\n    throw new Error(`Feishu account \"${account.accountId}\" not configured`);\n  }\n\n  const client = createFeishuClient({\n    ...account,\n    httpTimeoutMs: FEISHU_MEDIA_HTTP_TIMEOUT_MS,\n  });\n\n  // SDK accepts Buffer directly or fs.ReadStream for file paths\n  // Using Readable.from(buffer) causes issues with form-data library\n  // See: https://github.com/larksuite/node-sdk/issues/121\n  const fileData = typeof file === \"string\" ? fs.createReadStream(file) : file;\n\n  const safeFileName = sanitizeFileNameForUpload(fileName);\n\n  const response = await client.im.file.create({\n    data: {\n      file_type: fileType,\n      file_name: safeFileName,\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any -- SDK accepts Buffer or ReadStream\n      file: fileData as any,\n      ...(duration !== undefined && { duration }),\n    },\n  });\n\n  // SDK v1.30+ returns data directly without code wrapper on success\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- SDK response type\n  const responseAny = response as any;\n  if (responseAny.code !== undefined && responseAny.code !== 0) {\n    throw new Error(`Feishu file upload failed: ${responseAny.msg || `code ${responseAny.code}`}`);\n  }\n\n  const fileKey = responseAny.file_key ?? responseAny.data?.file_key;\n  if (!fileKey) {\n    throw new Error(\"Feishu file upload failed: no file_key returned\");\n  }\n\n  return { fileKey };\n}\n\n/**\n\n[203 more lines in file. Use offset=300 to continue.]"}],"isError":false,"timestamp":1773425016783}}
{"type":"message","id":"12c859e1","parentId":"9fd50563","timestamp":"2026-03-13T18:04:14.953Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"\n我需要把当前的uploadFileFeishu函数替换为新的，同时把原来的函数重命名为uploadFileFeishuInternal。\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_0qy5hebt39koa0a0w4i234fi","name":"edit","arguments":{"path":"/usr/lib/node_modules/openclaw/extensions/feishu/src/media.ts","old_string":"/**\n * Upload a file to Feishu and get a file_key for sending.\n * Max file size: 30MB\n */\nexport async function uploadFileFeishu(params: {\n  cfg: ClawdbotConfig;\n  file: Buffer | string; // Buffer or file path\n  fileName: string;\n  fileType: \"opus\" | \"mp4\" | \"pdf\" | \"doc\" | \"xls\" | \"ppt\" | \"stream\";\n  duration?: number; // Required for audio/video files, in milliseconds\n  accountId?: string;\n}): Promise<UploadFileResult> {\n  const { cfg, file, fileName, fileType, duration, accountId } = params;\n  const account = resolveFeishuAccount({ cfg, accountId });\n  if (!account.configured) {\n    throw new Error(`Feishu account \"${account.accountId}\" not configured`);\n  }\n\n  const client = createFeishuClient({\n    ...account,\n    httpTimeoutMs: FEISHU_MEDIA_HTTP_TIMEOUT_MS,\n  });\n\n  // SDK accepts Buffer directly or fs.ReadStream for file paths\n  // Using Readable.from(buffer) causes issues with form-data library\n  // See: https://github.com/larksuite/node-sdk/issues/121\n  const fileData = typeof file === \"string\" ? fs.createReadStream(file) : file;\n\n  const safeFileName = sanitizeFileNameForUpload(fileName);\n\n  const response = await client.im.file.create({\n    data: {\n      file_type: fileType,\n      file_name: safeFileName,\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any -- SDK accepts Buffer or ReadStream\n      file: fileData as any,\n      ...(duration !== undefined && { duration }),\n    },\n  });\n\n  // SDK v1.30+ returns data directly without code wrapper on success\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- SDK response type\n  const responseAny = response as any;\n  if (responseAny.code !== undefined && responseAny.code !== 0) {\n    throw new Error(`Feishu file upload failed: ${responseAny.msg || `code ${responseAny.code}`}`);\n  }\n\n  const fileKey = responseAny.file_key ?? responseAny.data?.file_key;\n  if (!fileKey) {\n    throw new Error(\"Feishu file upload failed: no file_key returned\");\n  }\n\n  return { fileKey };\n}","new_string":"/**\n * Upload a file to Feishu and get a file_key for sending.\n * Max file size: 30MB\n * \n * 修复：使用临时文件解决中文文件名乱码问题\n */\nexport async function uploadFileFeishu(params: {\n  cfg: ClawdbotConfig;\n  file: Buffer | string;\n  fileName: string;\n  fileType: \"opus\" | \"mp4\" | \"pdf\" | \"doc\" | \"xls\" | \"ppt\" | \"stream\";\n  duration?: number;\n  accountId?: string;\n}): Promise<UploadFileResult> {\n  const { cfg, file, fileName, fileType, duration, accountId } = params;\n  \n  // 检查是否需要临时文件修复\n  const ASCII_ONLY = /^[\\x00-\\x7F]+$/;\n  const needsTempFile = !ASCII_ONLY.test(fileName);\n  \n  if (needsTempFile) {\n    // 中文文件名，使用临时文件修复\n    const tempPath = createTempFilePath(fileName);\n    \n    try {\n      // 复制文件到临时位置（使用英文文件名）\n      if (typeof file === \"string\") {\n        await copyFile(file, tempPath);\n      } else {\n        await writeFile(tempPath, file);\n      }\n      \n      // 使用临时文件上传，但保留原始中文文件名作为显示名\n      return await uploadFileFeishuInternal({\n        cfg,\n        file: tempPath,\n        fileName,  // 原始中文文件名，用户会看到这个\n        fileType,\n        duration,\n        accountId\n      });\n    } finally {\n      // 清理临时文件\n      await unlink(tempPath).catch(() => {});\n    }\n  }\n  \n  // ASCII 文件名，直接上传\n  return uploadFileFeishuInternal({ cfg, file, fileName, fileType, duration, accountId });\n}\n\n/**\n * 内部实现：实际执行文件上传\n */\nasync function uploadFileFeishuInternal(params: {\n  cfg: ClawdbotConfig;\n  file: Buffer | string; // Buffer or file path\n  fileName: string;\n  fileType: \"opus\" | \"mp4\" | \"pdf\" | \"doc\" | \"xls\" | \"ppt\" | \"stream\";\n  duration?: number; // Required for audio/video files, in milliseconds\n  accountId?: string;\n}): Promise<UploadFileResult> {\n  const { cfg, file, fileName, fileType, duration, accountId } = params;\n  const account = resolveFeishuAccount({ cfg, accountId });\n  if (!account.configured) {\n    throw new Error(`Feishu account \"${account.accountId}\" not configured`);\n  }\n\n  const client = createFeishuClient({\n    ...account,\n    httpTimeoutMs: FEISHU_MEDIA_HTTP_TIMEOUT_MS,\n  });\n\n  // SDK accepts Buffer directly or fs.ReadStream for file paths\n  // Using Readable.from(buffer) causes issues with form-data library\n  // See: https://github.com/larksuite/node-sdk/issues/121\n  const fileData = typeof file === \"string\" ? fs.createReadStream(file) : file;\n\n  const safeFileName = sanitizeFileNameForUpload(fileName);\n\n  const response = await client.im.file.create({\n    data: {\n      file_type: fileType,\n      file_name: safeFileName,\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any -- SDK accepts Buffer or ReadStream\n      file: fileData as any,\n      ...(duration !== undefined && { duration }),\n    },\n  });\n\n  // SDK v1.30+ returns data directly without code wrapper on success\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any -- SDK response type\n  const responseAny = response as any;\n  if (responseAny.code !== undefined && responseAny.code !== 0) {\n    throw new Error(`Feishu file upload failed: ${responseAny.msg || `code ${responseAny.code}`}`);\n  }\n\n  const fileKey = responseAny.file_key ?? responseAny.data?.file_key;\n  if (!fileKey) {\n    throw new Error(\"Feishu file upload failed: no file_key returned\");\n  }\n\n  return { fileKey };\n}"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773425016789}}
