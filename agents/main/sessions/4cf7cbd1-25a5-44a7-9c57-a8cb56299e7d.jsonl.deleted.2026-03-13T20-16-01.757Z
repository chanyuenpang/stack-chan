{"type":"message","id":"0e0023b7","parentId":"614a930d","timestamp":"2026-03-13T19:16:48.983Z","message":{"role":"toolResult","toolCallId":"call_1qn0pvyou6ftush6qn6c54db","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env node\n/**\n * 日报生成脚本 (Node.js版本)\n * 生成 Markdown 和 DOCX 两种格式的日报\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst { execSync } = require('child_process');\n\nconst OUTPUT_DIR = path.join(process.env.HOME, 'DailyReports');\n\nfunction loadCrawlResults(filePath) {\n  const data = JSON.parse(fs.readFileSync(filePath, 'utf-8'));\n  return data.results || [];\n}\n\nfunction categorizeNews(newsList) {\n  const categories = {\n    \"国家部委\": [],\n    \"省级政策\": [],\n    \"市级政策\": [],\n    \"区级政策\": [],\n    \"行业协会\": [],\n    \"项目申报\": [],\n    \"其他\": []\n  };\n  \n  for (const news of newsList) {\n    const category = news.category || '其他';\n    \n    if (category.includes('国家') || category.includes('中华人民共和国')) {\n      categories[\"国家部委\"].push(news);\n    } else if (category.includes('省级') || category.includes('福建省')) {\n      categories[\"省级政策\"].push(news);\n    } else if (category.includes('市级') || category.includes('厦门市')) {\n      categories[\"市级政策\"].push(news);\n    } else if (category.includes('区级') || category.includes('思明') || category.includes('集美')) {\n      categories[\"区级政策\"].push(news);\n    } else if (category.includes('协会') || category.includes('行业')) {\n      categories[\"行业协会\"].push(news);\n    } else if (category.includes('申报') || category.includes('项目')) {\n      categories[\"项目申报\"].push(news);\n    } else {\n      categories[\"其他\"].push(news);\n    }\n  }\n  \n  // 移除空类别\n  return Object.fromEntries(Object.entries(categories).filter(([k, v]) => v.length > 0));\n}\n\nfunction generateMarkdown(newsList, dateStr) {\n  const total = newsList.length;\n  const categorized = categorizeNews(newsList);\n  const categoryCount = Object.keys(categorized).length;\n  \n  let md = `# 政府网站新闻政策日报\n\n**报告日期**: ${dateStr}\n**数据来源**: 17个政府网站\n**生成时间**: ${new Date().toLocaleString('zh-CN')}\n\n---\n\n## 概览\n\n| 统计项 | 数量 |\n|--------|------|\n| 监控网站数 | 17 |\n| 新增新闻/政策 | ${total} |\n| 分类数量 | ${categoryCount} |\n\n---\n\n`;\n  \n  // 如果没有数据，添加说明\n  if (total === 0) {\n    md += `## 数据抓取说明\n\n本次抓取未能获取到新闻数据，主要原因包括：\n\n1. **网站结构变化**: 部分政府网站近期进行了改版，DOM结构发生变化\n2. **动态加载机制**: 部分网站使用 JavaScript 动态加载内容，需要更复杂的处理\n3. **访问限制**: 部分网站可能有访问频率限制或需要特定请求头\n4. **网络连接**: 厦门市建设局网站 (js.xm.gov.cn) 域名解析失败\n\n### 已尝试的抓取网站\n\n本次共尝试抓取 17 个政府网站：\n\n- 国家部委: 科技部、工信部、发改委、自然资源部\n- 省级: 福建省科技厅、福建省教育厅\n- 市级: 厦门市人社局、发改委、科技局、工信局、建设局、数据管理局、总工会\n- 区级: 思明区科信局\n- 开发区: 火炬高新区\n- 行业协会: 市软件协会、中小企业服务中心\n\n### 后续改进建议\n\n1. 更新各网站的 CSS 选择器配置\n2. 增加对动态加载网站的支持（如使用 waitForFunction 等待内容加载）\n3. 添加更多备用选择器策略\n4. 增加请求头伪装和 User-Agent 轮换\n5. 考虑使用 RSS 源或 API 接口（如有提供）\n\n---\n\n`;\n  } else {\n    // 按类别输出\n    for (const [category, items] of Object.entries(categorized)) {\n      md += `## ${category} (${items.length}条)\\n\\n`;\n      \n      for (const item of items) {\n        md += `### ${item.title}\\n\\n`;\n        md += `- **来源**: ${item.site_name}\\n`;\n        md += `- **日期**: ${item.date}\\n`;\n        md += `- **链接**: ${item.url}\\n`;\n        md += `- **摘要**: ${item.summary}\\n\\n`;\n      }\n      \n      md += \"---\\n\\n\";\n    }\n  }\n  \n  // 页脚\n  md += `---\\n\\n`;\n  md += `**报告生成时间**: ${new Date().toLocaleString('zh-CN')}\\n`;\n  md += `**下次生成时间**: 明天 06:45\\n\\n`;\n  md += `---\\n\\n`;\n  md += `*本报告由 OpenClaw Daily News Crawler 自动生成*\\n`;\n  \n  return md;\n}\n\n\n\nfunction main() {\n  // 获取输入文件\n  let crawlResultFile;\n  if (process.argv.length > 2) {\n    crawlResultFile = process.argv[2];\n  } else {\n    // 查找最新的抓取结果文件\n    const resultFiles = fs.readdirSync(OUTPUT_DIR)\n      .filter(f => f.startsWith('crawl_result_') && f.endsWith('.json'))\n      .map(f => ({ name: f, time: fs.statSync(path.join(OUTPUT_DIR, f)).mtime }))\n      .sort((a, b) => b.time - a.time);\n    \n    if (resultFiles.length > 0) {\n      crawlResultFile = path.join(OUTPUT_DIR, resultFiles[0].name);\n    } else {\n      console.log('[ERROR] 未找到抓取结果文件');\n      process.exit(1);\n    }\n  }\n\n  const dateStr = new Date().toISOString().split('T')[0];\n\n  console.log(`[INFO] 加载抓取结果: ${crawlResultFile}`);\n  const newsList = loadCrawlResults(crawlResultFile);\n  console.log(`[INFO] 共 ${newsList.length} 条新闻`);\n\n  // 生成 Markdown\n  console.log('[INFO] 生成 Markdown 文档...');\n  const mdContent = generateMarkdown(newsList, dateStr);\n  \n  // 确保输出目录存在\n  const mdDir = path.join(OUTPUT_DIR, 'md');\n  const docDir = path.join(OUTPUT_DIR, 'doc');\n  if (!fs.existsSync(mdDir)) fs.mkdirSync(mdDir, { recursive: true });\n  if (!fs.existsSync(docDir)) fs.mkdirSync(docDir, { recursive: true });\n  \n  const mdFile = path.join(mdDir, `${dateStr}-日报.md`);\n  fs.writeFileSync(mdFile, mdContent, 'utf-8');\n  console.log(`[INFO] Markdown 已保存: ${mdFile}`);\n\n\n\n  // 转换MD到DOCX格式，使用docx-cn技能保证中文支持和格式正常\n  console.log('[INFO] 生成 DOCX 格式文档...');\n  const docxFile = path.join(docDir, `${dateStr}-日报.docx`);\n  try {\n    // 调用 docx-cn 转换工具：指定中文常用字体，自动生成目录，保留原MD排版\n    execSync(`openclaw acp skill run docx-cn convert --input \"${mdFile}\" --output \"${docxFile}\" --font \"SimSun,Microsoft YaHei\" --toc --line-spacing 1.5`, { stdio: 'inherit' });\n    console.log(`[INFO] DOCX 版本已保存: ${docxFile}`);\n  } catch (err) {\n    console.error(`[WARNING] DOCX 生成失败: ${err.message}`);\n  }\n\n  // 输出摘要\n  const categorized = categorizeNews(newsList);\n  console.log('\\n' + '='.repeat(60));\n  console.log('[INFO] 日报生成完成');\n  console.log(`[INFO] 总新闻数: ${newsList.length}`);\n  console.log(`[INFO] 分类数量: ${Object.keys(categorized).length}`);\n  console.log('[INFO] 已生成文件:');\n  console.log(`  - Markdown格式: ${mdFile}`);\n  if (fs.existsSync(docxFile)) {\n    console.log(`  - DOCX格式: ${docxFile}`);\n  }\n  for (const [cat, items] of Object.entries(categorized)) {\n    console.log(`  - ${cat}: ${items.length}条`);\n  }\n  console.log('='.repeat(60));\n}\n\nmain();\n"}],"isError":false,"timestamp":1773429408979}}
{"type":"message","id":"f98744e7","parentId":"0e0023b7","timestamp":"2026-03-13T19:16:54.259Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"\n完美，修改完成了，现在检查一下改动点：\n1. 修改了文件头注释，将三种输出改为两种：Markdown和DOCX\n2. 删除了不再使用的generateSimpleWordContent函数（原用于生成TXT格式）\n3. 删除了TXT格式生成的完整逻辑：包括生成TXT内容、写入TXT文件的代码\n4. 修改了DOCX生成失败的错误提示，移除了TXT替代的相关说明\n5. 修改了最终输出的文件列表，移除了TXT格式的输出提示\n6. 完全保留了DOCX转换的逻辑：包括中文字体指定（SimSun、Microsoft YaHei）、自动生成目录、1.5倍行间距等中文排版适配，以及try/catch容错处理逻辑\n\n现在任务完成了，可以给主代理返回结果了。\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"✅ 报告生成逻辑修改完成，改动点如下：\n1. **移除TXT格式相关逻辑**：\n   - 删除了文件头注释中的TXT格式说明\n   - 删除了`generateSimpleWordContent`纯文本转换函数\n   - 删除了TXT文件生成、写入的完整代码段\n   - 移除了输出摘要中的TXT格式文件提示\n   - 移除了DOCX生成失败时使用TXT作为替代的逻辑\n2. **保留的逻辑完全不变**：\n   - Markdown格式生成逻辑完整保留\n   - DOCX转换逻辑完整保留：仍然使用docx-cn技能，指定中文字体（SimSun、Microsoft YaHei）、自动生成目录、1.5倍行间距等中文排版适配逻辑\n   - DOCX转换的try/catch容错处理保留，仅修改了错误提示内容\n\n修改后的脚本仅输出MD和DOCX两种格式，符合需求。文件路径：`/home/yankeeting/.openclaw/workspace/projects/daily-news-crawler/scripts/generate-report-node.js`"}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1773429408983}}
