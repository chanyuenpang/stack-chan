ontrol\": \"max-age=0\"\n}\n\nclass NewsCrawler:\n    def __init__(self):\n        self.results: List[Dict] = []\n        self.errors: List[Dict] = []\n        \n    async def crawl_site(self, page: Page, site_config: Dict) -> List[Dict]:\n        \"\"\"抓取单个网站的新闻\"\"\"\n\n[212 more lines in file. Use offset=51 to continue.]"}],"isError":false,"timestamp":1773426592954}}
