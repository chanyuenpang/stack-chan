: 0\n失败: 3\n\n【选择器配置评估】\n  ❌ 需调整 - 厦门市人力资源和社会保障局\n  ❌ 需调整 - 厦门科学技术局\n  ❌ 需调整 - 厦门市软件行业协会","cwd":"/home/yankeeting/.openclaw/workspace"},"isError":false,"timestamp":1773462042910}}
{"type":"message","id":"aba753bf","parentId":"26f03906","timestamp":"2026-03-14T04:22:40.534Z","message":{"role":"assistant","content":[{"type":"text","text":"根据调试信息，页面HTML内容已经获取到了，但选择器找不到元素。让我分析一下HTML样本并重新设计选择器。我需要更仔细地检查这些页面的实际结构。\n\n从HTML样本看：\n1. 人社局页面使用了 Avalon 框架，可能需要等待JS渲染\n2. 科技局页面也是类似的情况\n3. 软件协会页面看起来是传统的ASP.NET页面\n\n让我重新写一个更智能的测试脚本，尝试多种选择器策略："},{"type":"toolCall","id":"write:7","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/projects/daily-news-crawler/test_selectors_v2.py","content":"#!/usr/bin/env python3\n\"\"\"\n测试3个网站的CSS选择器 - V2版本\n增加多策略选择器和智能等待\n\"\"\"\n\nimport asyncio\nfrom playwright.async_api import async_playwright\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Dict, Any\n\n\n@dataclass\nclass NewsItem:\n    title: str\n    date: str\n    link: str\n\n\n@dataclass\nclass TestResult:\n    name: str\n    url: str\n    success: bool\n    items: List[NewsItem]\n    working_selector: Optional[Dict[str, str]] = None\n    error: Optional[str] = None\n\n\n# 为每个网站定义多个备选选择器策略\nSELECTOR_STRATEGIES = {\n    \"厦门市人力资源和社会保障局\": [\n        {\n            \"list\": \".content_list tr\",\n            \"title\": \"a\",\n            \"date\": \".td_r\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".content_list tbody tr\",\n            \"title\": \"a\",\n            \"date\": \".td_r\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".list ul li\",\n            \"title\": \"a\",\n            \"date\": \"span\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".news-list li\",\n            \"title\": \"a\",\n            \"date\": \".date, .time\",\n            \"link\": \"a\",\n        },\n    ],\n    \"厦门科学技术局\": [\n        {\n            \"list\": \".xwzx-list li\",\n            \"title\": \"a\",\n            \"date\": \".date\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".news-list li\",\n            \"title\": \"a\",\n            \"date\": \".date\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".list li\",\n            \"title\": \"a\",\n            \"date\": \"span\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".index-news-list li\",\n            \"title\": \"a\",\n            \"date\": \".date\",\n            \"link\": \"a\",\n        },\n    ],\n    \"厦门市软件行业协会\": [\n        {\n            \"list\": \".newList li\",\n            \"title\": \".title a\",\n            \"date\": \".date\",\n            \"link\": \".title a\",\n        },\n        {\n            \"list\": \".newsList li\",\n            \"title\": \".title a, a\",\n            \"date\": \".date, span\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".list li\",\n            \"title\": \"a\",\n            \"date\": \"span\",\n            \"link\": \"a\",\n        },\n        {\n            \"list\": \".news-list li\",\n            \"title\": \"a\",\n            \"date\": \".date\",\n            \"link\": \"a\",\n        },\n    ],\n}\n\n\nasync def try_extract_data(page, selector_strategy: Dict[str, str], url: str) -> Optional[List[NewsItem]]:\n    \"\"\"尝试使用给定的选择器策略提取数据\"\"\"\n    try:\n        list_selector = selector_strategy[\"list\"]\n        title_selector = selector_strategy[\"title\"]\n        date_selector = selector_strategy[\"date\"]\n        link_selector = selector_strategy[\"link\"]\n\n        # 查找列表项\n        list_items = await page.query_selector_all(list_selector)\n        \n        if len(list_items) == 0:\n            return None\n\n        print(f\"    ✓ 选择器 '{list_selector}' 找到 {len(list_items)} 个元素\")\n\n        # 提取数据\n        items = []\n        for item in list_items[:5]:  # 最多取5条\n            try:\n                # 提取标题\n                title_elem = await item.query_selector(title_selector)\n                title = await title_elem.inner_text() if title_elem else \"\"\n                title = title.strip() if title else \"\"\n\n                # 提取日期\n                date_elem = await item.query_selector(date_selector)\n                date = await date_elem.inner_text() if date_elem else \"\"\n                date = date.strip() if date else \"\"\n\n                # 提取链接\n                link_elem = await item.query_selector(link_selector)\n                link = \"\"\n                if link_elem:\n                    href = await link_elem.get_attribute(\"href\")\n                    if href:\n                        # 处理相对链接\n                        if href.startswith(\"http\"):\n                            link = href\n                        elif href.startswith(\"/\"):\n                            from urllib.parse import urlparse\n                            parsed = urlparse(url)\n                            link = f\"{parsed.scheme}://{parsed.netloc}{href}\"\n                        else:\n                            link = f\"{url.rstrip('/')}/{href}\"\n\n                if title:  # 只有有标题才算有效数据\n                    items.append(NewsItem(title=title, date=date, link=link))\n            except Exception as e:\n                pass  # 忽略单条数据提取错误\n\n        if len(items) > 0:\n            return items\n        return None\n\n    except Exception as e:\n        return None\n\n\nasync def test_website(\n    page,\n    name: str,\n    url: str,\n) -> TestResult:\n    \"\"\"测试单个网站，尝试多个选择器策略\"\"\"\n    try:\n        print(f\"\\n{'='*70}\")\n        print(f\"测试: {name}\")\n        print(f\"URL: {url}\")\n        print(f\"{'='*70}\")\n\n        # 访问页面\n        print(\"正在加载页面...\")\n        await page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n        \n        # 额外等待JavaScript渲染\n        print(\"等待页面渲染...\")\n        await asyncio.sleep(5)  # 增加等待时间\n        \n        print(\"页面加载完成\")\n\n        # 获取页面标题\n        title = await page.title()\n        print(f\"页面标题: {title}\")\n\n        # 尝试多个选择器策略\n        strategies = SELECTOR_STRATEGIES.get(name, [])\n        \n        if not strategies:\n            return TestResult(\n                name=name,\n                url=url,\n                success=False,\n                items=[],\n                error=\"未定义选择器策略\",\n            )\n\n        print(f\"\\n尝试 {len(strategies)} 个选择器策略...\")\n        \n        for i, strategy in enumerate(strategies, 1):\n            print(f\"\\n  策略 {i}: list='{strategy['list']}'\")\n            items = await try_extract_data(page, strategy, url)\n            \n            if items:\n                print(f\"    ✓ 成功提取 {len(items)} 条数据\")\n                return TestResult(\n                    name=name,\n                    url=url,\n                    success=True,\n                    items=items,\n                    working_selector=strategy,\n                )\n            else:\n                print(f\"    ✗ 未能提取数据\")\n\n        # 所有策略都失败了\n        return TestResult(\n            name=name,\n            url=url,\n            success=False,\n            items=[],\n            error=\"所有选择器策略都未能提取到数据\",\n        )\n\n    except Exception as e:\n        return TestResult(\n            name=name,\n            url=url,\n            success=False,\n            items=[],\n            error=str(e),\n        )\n\n\nasync def main():\n    \"\"\"主函数\"\"\"\n    print(\"=\" * 80)\n    print(\"网站CSS选择器测试工具 V2（多策略版）\")\n    print(\"=\" * 80)\n\n    # 定义要测试的网站\n    websites = [\n        {\n            \"name\": \"厦门市人力资源和社会保障局\",\n            \"url\": \"http://hrss.xm.gov.cn/xygk/tzgg/\",\n        },\n        {\n            \"name\": \"厦门科学技术局\",\n            \"url\": \"http://sti.xm.gov.cn/\",\n        },\n        {\n            \"name\": \"厦门市软件行业协会\",\n            \"url\": \"http://www.xmsia.cn/Pages/Home/NewsList.aspx?classId=3\",\n        },\n    ]\n\n    results = []\n\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        context = await browser.new_context(\n            user_agent=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n        )\n        page = await context.new_page()\n\n        for website in websites:\n            result = await test_website(page, **website)\n            results.append(result)\n\n        await browser.close()\n\n    # 打印测试报告\n    print(\"\\n\" + \"=\" * 80)\n    print(\"测试报告\")\n    print(\"=\" * 80)\n\n    success_count = 0\n    for result in results:\n        status = \"✅ 成功\" if result.success else \"❌ 失败\"\n        print(f\"\\n【{result.name}】\")\n        print(f\"  状态: {status}\")\n        print(f\"  URL: {result.url}\")\n\n        if result.success:\n            success_count += 1\n            print(f\"  抓取数量: {len(result.items)} 条\")\n            if result.working_selector:\n                print(f\"  有效选择器:\")\n                print(f\"    list: {result.working_selector['list']}\")\n                print(f\"    title: {result.working_selector['title']}\")\n                print(f\"    date: {result.working_selector['date']}\")\n                print(f\"    link: {result.working_selector['link']}\")\n            print(f\"\\n  前3条公告:\")\n            for i, item in enumerate(result.items[:3], 1):\n                print(f\"    {i}. {item.title}\")\n                print(f\"       日期: {item.date}\")\n                print(f\"       链接: {item.link}\")\n        else:\n            print(f\"  失败原因: {result.error}\")\n\n    print(\"\\n\" + \"=\" * 80)\n    print(\"总结\")\n    print(\"=\" * 80)\n    print(f\"测试网站总数: {len(results)}\")\n    print(f\"成功: {success_count}\")\n    print(f\"失败: {len(results) - success_count}\")\n\n    print(\"\\n【选择器配置评估】\")\n    for result in results:\n        if result.success:\n            print(f\"  ✅ 正确 - {result.name}\")\n            if result.working_selector:\n                print(f\"     推荐选择器:\")\n                print(f\"       list: {result.working_selector['list']}\")\n                print(f\"       title: {result.working_selector['title']}\")\n                print(f\"       date: {result.working_selector['date']}\")\n                print(f\"       link: {result.working_selector['link']}\")\n        else:\n            print(f\"  ❌ 需调整 - {result.name}\")\n\n    return results\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773462042911}}
