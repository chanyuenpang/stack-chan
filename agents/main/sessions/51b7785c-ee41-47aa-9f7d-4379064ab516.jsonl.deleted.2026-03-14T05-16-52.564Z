试网站总数: 3\n成功: 0\n失败: 3\n\n【选择器配置评估】\n  ❌ 需调整 - 厦门市人力资源和社会保障局\n  ❌ 需调整 - 厦门科学技术局\n  ❌ 需调整 - 厦门市软件行业协会","cwd":"/home/yankeeting/.openclaw/workspace"},"isError":false,"timestamp":1773461925102}}
{"type":"message","id":"0afd6a0d","parentId":"49e9665d","timestamp":"2026-03-14T04:20:22.359Z","message":{"role":"assistant","content":[{"type":"text","text":"所有三个网站都失败了，原因是超时。让我修改测试脚本，增加等待时间和调试信息，同时尝试不同的策略来定位元素。"},{"type":"toolCall","id":"write:5","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/projects/daily-news-crawler/test_selectors_debug.py","content":"#!/usr/bin/env python3\n\"\"\"\n调试版本 - 测试3个网站的CSS选择器\n增加更多调试信息和备用策略\n\"\"\"\n\nimport asyncio\nfrom playwright.async_api import async_playwright\nfrom dataclasses import dataclass\nfrom typing import List, Optional\n\n\n@dataclass\nclass NewsItem:\n    title: str\n    date: str\n    link: str\n\n\n@dataclass\nclass TestResult:\n    name: str\n    url: str\n    success: bool\n    items: List[NewsItem]\n    error: Optional[str] = None\n    html_sample: Optional[str] = None\n\n\nasync def debug_page_structure(page, url: str):\n    \"\"\"调试页面结构\"\"\"\n    try:\n        print(f\"\\n--- 调试页面结构: {url} ---\")\n        \n        # 获取页面标题\n        title = await page.title()\n        print(f\"页面标题: {title}\")\n        \n        # 获取页面HTML片段\n        html = await page.content()\n        print(f\"页面HTML长度: {len(html)} 字符\")\n        \n        # 查找常见的列表容器\n        common_selectors = [\n            \".content_list\",\n            \".news-list\",\n            \".list\",\n            \".news\",\n            \".xwzx-list\",\n            \".newList\",\n            \".list-box\",\n            \"ul\",\n            \".table\",\n        ]\n        \n        print(\"\\n查找常见列表容器:\")\n        for selector in common_selectors:\n            try:\n                elements = await page.query_selector_all(selector)\n                if elements:\n                    print(f\"  ✓ {selector}: 找到 {len(elements)} 个元素\")\n                    # 显示第一个元素的结构\n                    if len(elements) > 0:\n                        html_sample = await elements[0].inner_html()\n                        if len(html_sample) > 200:\n                            html_sample = html_sample[:200] + \"...\"\n                        print(f\"    结构示例: {html_sample}\")\n            except Exception as e:\n                pass\n        \n        return html[:1000]  # 返回HTML前1000字符作为样本\n    except Exception as e:\n        print(f\"调试页面结构出错: {e}\")\n        return None\n\n\nasync def test_website(\n    page,\n    name: str,\n    url: str,\n    list_selector: str,\n    title_selector: str,\n    date_selector: str,\n    link_selector: str,\n) -> TestResult:\n    \"\"\"测试单个网站\"\"\"\n    try:\n        print(f\"\\n{'='*70}\")\n        print(f\"测试: {name}\")\n        print(f\"URL: {url}\")\n        print(f\"List选择器: {list_selector}\")\n        print(f\"{'='*70}\")\n\n        # 访问页面\n        print(\"正在加载页面...\")\n        await page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n        \n        # 额外等待JavaScript渲染\n        print(\"等待页面渲染...\")\n        await asyncio.sleep(3)\n        \n        print(\"页面加载完成\")\n\n        # 调试页面结构\n        html_sample = await debug_page_structure(page, url)\n\n        # 尝试查找列表元素\n        print(f\"\\n尝试查找列表元素: {list_selector}\")\n        list_items = await page.query_selector_all(list_selector)\n        print(f\"找到 {len(list_items)} 个列表项\")\n\n        if len(list_items) == 0:\n            return TestResult(\n                name=name,\n                url=url,\n                success=False,\n                items=[],\n                error=f\"未找到任何列表项，选择器: {list_selector}\",\n                html_sample=html_sample,\n            )\n\n        # 提取数据\n        items = []\n        print(f\"\\n提取数据（最多5条）:\")\n        for i, item in enumerate(list_items[:5]):\n            try:\n                # 提取标题\n                title_elem = await item.query_selector(title_selector)\n                title = await title_elem.inner_text() if title_elem else \"\"\n                title = title.strip() if title else \"\"\n\n                # 提取日期\n                date_elem = await item.query_selector(date_selector)\n                date = await date_elem.inner_text() if date_elem else \"\"\n                date = date.strip() if date else \"\"\n\n                # 提取链接\n                link_elem = await item.query_selector(link_selector)\n                link = \"\"\n                if link_elem:\n                    href = await link_elem.get_attribute(\"href\")\n                    if href:\n                        # 处理相对链接\n                        if href.startswith(\"http\"):\n                            link = href\n                        elif href.startswith(\"/\"):\n                            from urllib.parse import urlparse\n                            parsed = urlparse(url)\n                            link = f\"{parsed.scheme}://{parsed.netloc}{href}\"\n                        else:\n                            link = f\"{url.rstrip('/')}/{href}\"\n\n                if title:  # 只有有标题才算有效数据\n                    items.append(NewsItem(title=title, date=date, link=link))\n                    print(f\"  [{i+1}] {title[:60]}{'...' if len(title) > 60 else ''}\")\n                    print(f\"      日期: {date}\")\n            except Exception as e:\n                print(f\"  [{i+1}] 提取数据出错: {e}\")\n\n        if len(items) > 0:\n            return TestResult(\n                name=name,\n                url=url,\n                success=True,\n                items=items,\n                html_sample=html_sample,\n            )\n        else:\n            return TestResult(\n                name=name,\n                url=url,\n                success=False,\n                items=[],\n                error=\"未能提取到有效数据（所有列表项都没有标题）\",\n                html_sample=html_sample,\n            )\n\n    except Exception as e:\n        return TestResult(\n            name=name,\n            url=url,\n            success=False,\n            items=[],\n            error=str(e),\n        )\n\n\nasync def main():\n    \"\"\"主函数\"\"\"\n    print(\"=\" * 80)\n    print(\"网站CSS选择器测试工具（调试版）\")\n    print(\"=\" * 80)\n\n    # 定义要测试的网站\n    websites = [\n        {\n            \"name\": \"厦门市人力资源和社会保障局\",\n            \"url\": \"http://hrss.xm.gov.cn/xygk/tzgg/\",\n            \"list_selector\": \".content_list tr\",\n            \"title_selector\": \"a\",\n            \"date_selector\": \".td_r\",\n            \"link_selector\": \"a\",\n        },\n        {\n            \"name\": \"厦门科学技术局\",\n            \"url\": \"http://sti.xm.gov.cn/\",\n            \"list_selector\": \".xwzx-list li\",\n            \"title_selector\": \"a\",\n            \"date_selector\": \".date\",\n            \"link_selector\": \"a\",\n        },\n        {\n            \"name\": \"厦门市软件行业协会\",\n            \"url\": \"http://www.xmsia.cn/Pages/Home/NewsList.aspx?classId=3\",\n            \"list_selector\": \".newList li\",\n            \"title_selector\": \".title a\",\n            \"date_selector\": \".date\",\n            \"link_selector\": \".title a\",\n        },\n    ]\n\n    results = []\n\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        context = await browser.new_context(\n            user_agent=\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n        )\n        page = await context.new_page()\n\n        for website in websites:\n            result = await test_website(page, **website)\n            results.append(result)\n\n        await browser.close()\n\n    # 打印测试报告\n    print(\"\\n\" + \"=\" * 80)\n    print(\"测试报告\")\n    print(\"=\" * 80)\n\n    success_count = 0\n    for result in results:\n        status = \"✅ 成功\" if result.success else \"❌ 失败\"\n        print(f\"\\n【{result.name}】\")\n        print(f\"  状态: {status}\")\n        print(f\"  URL: {result.url}\")\n\n        if result.success:\n            success_count += 1\n            print(f\"  抓取数量: {len(result.items)} 条\")\n            print(f\"\\n  前3条公告:\")\n            for i, item in enumerate(result.items[:3], 1):\n                print(f\"    {i}. {item.title}\")\n                print(f\"       日期: {item.date}\")\n                print(f\"       链接: {item.link}\")\n        else:\n            print(f\"  失败原因: {result.error}\")\n            if result.html_sample:\n                print(f\"\\n  HTML样本 (前500字符):\")\n                print(f\"  {result.html_sample[:500]}...\")\n\n    print(\"\\n\" + \"=\" * 80)\n    print(\"总结\")\n    print(\"=\" * 80)\n    print(f\"测试网站总数: {len(results)}\")\n    print(f\"成功: {success_count}\")\n    print(f\"失败: {len(results) - success_count}\")\n\n    print(\"\\n【选择器配置评估】\")\n    for result in results:\n        status = \"✅ 正确\" if result.success else \"❌ 需调整\"\n        print(f\"  {status} - {result.name}\")\n\n    return results\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773461925103}}
