{"type":"message","id":"9974ef19","parentId":"4d5b366a","timestamp":"2026-03-13T19:17:36.891Z","message":{"role":"toolResult","toolCallId":"call_1xted2b40ambl0rbunj6zvq5","toolName":"read","content":[{"type":"text","text":"{\n  \"version\": \"1.0\",\n  \"description\": \"政府网站新闻政策监控列表\",\n  \"lastUpdated\": \"2025-03-13\",\n  \"sources\": [\n    {\n      \"id\": \"xm_hrss\",\n      \"name\": \"厦门市人力资源和社会保障局\",\n      \"category\": \"社保人社\",\n      \"url\": \"http://hrss.xm.gov.cn/xygk/tzgg/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_dpc\",\n      \"name\": \"厦门市发展和改革委员会\",\n      \"category\": \"发改政策\",\n      \"url\": \"http://dpc.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item, .news_item\",\n        \"title\": \".title, a, .news_title\",\n        \"date\": \".date, .time, .news_date\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_sti\",\n      \"name\": \"厦门科学技术局\",\n      \"category\": \"科技政策\",\n      \"url\": \"http://sti.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"most\",\n      \"name\": \"中华人民共和国科学技术部\",\n      \"category\": \"国家科技政策\",\n      \"url\": \"http://www.most.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item, .content-list li\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_sme\",\n      \"name\": \"厦门市中小企业服务中心\",\n      \"category\": \"中小企业服务\",\n      \"url\": \"http://www.xmsme.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"miit\",\n      \"name\": \"中华人民共和国工业和信息化部\",\n      \"category\": \"国家工信政策\",\n      \"url\": \"http://www.miit.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item, .content-list li\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"ndrc\",\n      \"name\": \"中华人民共和国国家发展和改革委员会\",\n      \"category\": \"国家发改政策\",\n      \"url\": \"http://www.ndrc.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"mnr\",\n      \"name\": \"自然资源部门户网站\",\n      \"category\": \"自然资源政策\",\n      \"url\": \"http://www.mnr.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"fj_kjt\",\n      \"name\": \"福建省科技厅\",\n      \"category\": \"省级科技政策\",\n      \"url\": \"http://kjt.fujian.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_jsj\",\n      \"name\": \"厦门市建设局\",\n      \"category\": \"建设政策\",\n      \"url\": \"http://js.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date, .time\",\n        \"link\": \"a\"\n      }\n    },\n    {\n      \"id\": \"xm_gxj\",\n      \"name\": \"厦门市工业和信息化局\",\n      \"category\": \"工信政策\",\n      \"url\": \"http://gxj.xm.gov.cn/\",\n      \"selector\": {\n        \"list\": \".news-list li, .list-item\",\n        \"title\": \".title, a\",\n        \"date\": \".date