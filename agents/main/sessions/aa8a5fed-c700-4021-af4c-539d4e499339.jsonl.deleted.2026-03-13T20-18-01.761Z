{"type":"message","id":"7aa23882","parentId":"3d635e01","timestamp":"2026-03-13T19:17:54.910Z","message":{"role":"toolResult","toolCallId":"call_h84qg5e0vwth4asmh7iq7xps","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"\n政府网站新闻抓取脚本\n每日抓取 40 个政府网站的新闻和政策\n\"\"\"\n\nimport asyncio\nimport json\nimport re\nimport random\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom typing import List, Dict, Optional\nfrom urllib.parse import urljoin, urlparse\n\nfrom playwright.async_api import async_playwright, Page\n\n# 配置\nCONFIG_DIR = Path(\"~/.openclaw/workspace/projects/daily-news-crawler/config\").expanduser()\nOUTPUT_DIR = Path(\"~/DailyReports\").expanduser()\nDAYS_BACK = 7  # 抓取最近 7 天的内容\nMAX_RETRIES = 3  # 最大重试次数\nUSER_AGENTS = [\n    \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36\",\n    \"Mozilla/5.0 (Macintosh; Intel Mac OS X 14_3) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.3.1 Safari/605.1.15\",\n    \"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:123.0) Gecko/20100101 Firefox/123.0\",\n    \"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36\",\n    \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Edge/122.0.0.0 Safari/537.36\",\n    \"Mozilla/5.0 (Macintosh; Intel Mac OS X 14_3) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36\"\n]\nREQUEST_HEADERS = {\n    \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8\",\n    \"Accept-Language\": \"zh-CN,zh;q=0.8,zh-TW;q=0.7,zh-HK;q=0.5,en-US;q=0.3,en;q=0.2\",\n    \"Accept-Encoding\": \"gzip, deflate, br\",\n    \"Connection\": \"keep-alive\",\n    \"Upgrade-Insecure-Requests\": \"1\",\n    \"Sec-Fetch-Dest\": \"document\",\n    \"Sec-Fetch-Mode\": \"navigate\",\n    \"Sec-Fetch-Site\": \"none\",\n    \"Sec-Fetch-User\": \"?1\",\n    \"Cache-Control\": \"max-age=0\"\n}\n\nclass NewsCrawler:\n    def __init__(self):\n        self.results: List[Dict] = []\n        self.errors: List[Dict] = []\n        \n    async def crawl_site(self, page: Page, site_config: Dict) -> List[Dict]:\n        \"\"\"抓取单个网站的新闻\"\"\"\n        url = site_config[\"url\"]\n        name = site_config[\"name\"]\n        selectors = site_config.get(\"selector\", {})\n        \n        print(f\"[INFO] 正在抓取: {name} ({url})\")\n        \n        try:\n            # 访问页面\n            await page.goto(url, wait_until=\"networkidle\", timeout=30000)\n            await page.wait_for_load_state(\"domcontentloaded\")\n            \n            # 等待内容加载\n            list_selector = selectors.get(\"list\", \".news-list li, .list-item\")\n            try:\n                await page.wait_for_selector(list_selector, timeout=10000)\n            except:\n                print(f\"[WARN] {name}: 未找到列表元素，尝试备用选择器\")\n                # 尝试其他常见选择器\n                for backup in [\".news-item\", \".list-news li\", \".content-list li\", \"tr\"]:\n                    try:\n                        await page.wait_for_selector(backup, timeout=5000)\n                        list_selector = backup\n                        print(f\"[INFO] {name}: 使用备用选择器 {backup}\")\n                        break\n                    except:\n                        continue\n            \n            # 提取新闻列表\n            items = await page.query_selector_all(list_selector)\n            print(f\"[INFO] {name}: 找到 {len(items)} 个条目\")\n            \n            news_list = []\n            for item in items[:20]:  # 最多取前 20 条\n                try:\n                    # 提取标题\n                    title_elem = await item.query_selector(selectors.get(\"title\", \".title, a, .news-title\"))\n                    if not title_elem:\n                        title_elem = item  # 如果找不到，就用 item 本身\n                    \n                    title = await title_elem.text_content()\n                    title = title.strip() if title else \"\"\n                    \n                    if not title or len(title) < 5:\n                        continue\n                    \n                    # 提取链接\n                    link_elem = await item.query_selector(\"a\")\n                    if link_elem:\n                        href = await link_elem.get_attribute(\"href\")\n                        if href:\n                            link = urljoin(url, href)\n                        else:\n                            link = url\n                    else:\n                        link = url\n                    \n                    # 提取日期\n                    date = \"\"\n                    date_elem = await item.query_selector(selectors.get(\"date\", \".date, .time, .news-date\"))\n                    if date_elem:\n                        date_text = await date_elem.text_content()\n                        date = self.parse_date(date_text.strip())\n                    \n                    if not date:\n                        # 如果没有日期，使用当前日期（假设是最新内容）\n                        date = datetime.now().strftime(\"%Y-%m-%d\")\n                    \n                    # 检查是否在指定时间范围内\n                    try:\n                        item_date = datetime.strptime(date, \"%Y-%m-%d\")\n                        cutoff_date = datetime.now() - timedelta(days=DAYS_BACK)\n                        if item_date < cutoff_date:\n                            continue  # 跳过旧内容\n                    except:\n                        pass\n                    \n                    # 提取摘要（如果有）\n                    summary = \"\"\n                    summary_elem = await item.query_selector(selectors.get(\"summary\", \".summary, .content, .news-content\"))\n                    if summary_elem:\n                        summary_text = await summary_elem.text_content()\n                        summary = summary_text.strip()[:100] + \"...\" if len(summary_text) > 100 else summary_text.strip()\n                    \n                    if not summary:\n                        summary = title[:50] + \"...\" if len(title) > 50 else title\n                    \n                    news_item = {\n                        \"site_name\": name,\n                        \"site_url\": url,\n                        \"category\": site_config.get(\"category\", \"其他\"),\n                        \"title\": title,\n                        \"url\": link,\n                        \"date\": date,\n                        \"summary\": summary,\n                        \"crawled_at\": datetime.now().isoformat()\n                    }\n                    \n                    news_list.append(news_item)\n                    \n                except Exception as e:\n                    print(f\"[WARN] {name}: 解析条目失败: {str(e)}\")\n                    continue\n            \n            print(f\"[INFO] {name}: 成功提取 {len(news_list)} 条新闻\")\n            return news_list\n            \n        except Exception as e:\n            error_msg = f\"[ERROR] {name}: 抓取失败 - {str(e)}\"\n            print(error_msg)\n            self.errors.append({\n                \"site_name\": name,\n                \"site_url\": url,\n                \"error\": str(e),\n                \"timestamp\": datetime.now().isoformat()\n            })\n            return []\n    \n    def parse_date(self, date_text: str) -> str:\n        \"\"\"解析各种日期格式\"\"\"\n        date_text = date_text.strip()\n        \n        # 常见日期格式\n        patterns = [\n            (r\"(\\d{4})-(\\d{2})-(\\d{2})\", \"%Y-%m-%d\"),\n            (r\"(\\d{4})/(\\d{2})/(\\d{2})\", \"%Y/%m/%d\"),\n            (r\"(\\d{4})年(\\d{2})月(\\d{2})日\", \"%Y年%m月%d日\"),\n            (r\"(\\d{2})-(\\d{2})\", \"%m-%d\"),  # 只有月日，假设今年\n        ]\n        \n        for pattern, fmt in patterns:\n            match = re.search(pattern, date_text)\n            if match:\n                try:\n                    if len(match.groups()) == 2:  # 只有月日\n                        year = datetime.now().year\n                        month, day = match.groups()\n                        return f\"{year}-{month}-{day}\"\n                    else:\n                        return match.group(0).replace(\"/\", \"-\").replace(\"年\", \"-\").replace(\"月\", \"-\").replace(\"日\", \"\")\n                except:\n                    continue\n        \n        return \"\"\n    \n    async def run(self):\n        \"\"\"运行抓取任务\"\"\"\n        print(\"=\" * 60)\n        print(f\"[INFO] 开始抓取任务 - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n        print(\"=\" * 60)\n        \n        # 读取配置\n        config_file = CONFIG_DIR / \"urls.json\"\n        if not config_file.exists():\n            print(f\"[ERROR] 配置文件不存在: {config_file}\")\n            return []\n        \n        with open(config_file, \"r\", encoding=\"utf-8\") as f:\n            config = json.load(f)\n        \n        sites = config.get(\"sources\", [])\n        print(f\"[INFO] 共 {len(sites)} 个网站需要抓取\")\n        \n        # 使用 Playwright 抓取\n        async with async_playwright() as p:\n            browser = await p.chromium.launch(headless=True)\n            \n            # 串行抓取（避免并发过大）\n            for i, site in enumerate(sites, 1):\n                print(f\"\\n[{i}/{len(sites)}] \", end=\"\")\n                \n                page = await browser.new_page()\n                \n                try:\n                    news = await self.crawl_site(page, site)\n                    self.results.extend(news)\n                except Exception as e:\n                    print(f\"[ERROR] 未捕获的异常: {str(e)}\")\n                \n                await page.close()\n            \n            await browser.close()\n        \n        # 输出统计\n        print(\"\\n\" + \"=\" * 60)\n        print(f\"[INFO] 抓取完成 - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n        print(f\"[INFO] 成功抓取: {len(self.results)} 条新闻\")\n        print(f\"[INFO] 失败站点: {len(self.errors)} 个\")\n        print(\"=\" * 60)\n        \n        return self.results\n\n\nasync def main():\n    \"\"\"主函数\"\"\"\n    crawler = NewsCrawler()\n    results = await crawler.run()\n    \n    # 输出结果到文件（用于调试）\n    output_file = OUTPUT_DIR / f\"crawl_result_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json\"\n    with open(output_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump({\n            \"results\": results,\n            \"errors\": crawler.errors,\n            \"timestamp\": datetime.now().isoformat()\n        }, f, ensure_ascii=False, indent=2)\n    \n    print(f\"[INFO] 结果已保存到: {output_file}\")\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n"}],"isError":false,"timestamp":1773429474907}}
{"type":"message","id":"24b5793a","parentId":"7aa23882","timestamp":"2026-03-13T19:18:17.807Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"\nOK, now I have the crawler config. Now let's test each of the 5 sites one by one using Playwright to see what's wrong. Let's create a small test script to test each site, check for anti-scraping, selector matching, etc.\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_xl2yuqbxxvv53r4oe7pgegu1","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/test-failed-sites.py","content":"#!/usr/bin/env python3\nimport asyncio\nimport json\nfrom playwright.async_api import async_playwright\n\n# 5个失败站点配置\nTEST_SITES = [\n    {\n        \"id\": \"xm_hrss\",\n        \"name\": \"厦门市人力资源和社会保障局\",\n        \"url\": \"http://hrss.xm.gov.cn/xygk/tzgg/\",\n        \"selector\": {\n            \"list\": \".news-list li, .list-item\",\n            \"title\": \".title, a\",\n            \"date\": \".date, .time\",\n            \"link\": \"a\"\n        }\n    },\n    {\n        \"id\": \"xm_sti\",\n        \"name\": \"厦门科学技术局\",\n        \"url\": \"http://sti.xm.gov.cn/\",\n        \"selector\": {\n            \"list\": \".news-list li, .list-item\",\n            \"title\": \".title, a\",\n            \"date\": \".date, .time\",\n            \"link\": \"a\"\n        }\n    },\n    {\n        \"id\": \"xm_software\",\n        \"name\": \"厦门市软件行业协会\",\n        \"url\": \"http://www.xmsia.cn/Pages/Home/NewsList.aspx?classId=3\",\n        \"selector\": {\n            \"list\": \".news-list li, .list-item\",\n            \"title\": \".title, a\",\n            \"date\": \".date, .time\",\n            \"link\": \"a\"\n        }\n    },\n    {\n        \"id\": \"most\",\n        \"name\": \"中华人民共和国科学技术部\",\n        \"url\": \"http://www.most.gov.cn/\",\n        \"selector\": {\n            \"list\": \".news-list li, .list-item, .content-list li\",\n            \"title\": \".title, a\",\n            \"date\": \".date, .time\",\n            \"link\": \"a\"\n        }\n    },\n    {\n        \"id\": \"fj_kjt\",\n        \"name\": \"福建省科技厅\",\n        \"url\": \"http://kjt.fujian.gov.cn/\",\n        \"selector\": {\n            \"list\": \".news-list li, .list-item\",\n            \"title\": \".title, a\",\n            \"date\": \".date, .time\",\n            \"link\": \"a\"\n        }\n    }\n]\n\nUSER_AGENT = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36\"\n\nasync def test_site(page, site):\n    result = {\n        \"name\": site[\"name\"],\n        \"url\": site[\"url\"],\n        \"success\": False,\n        \"error\": None,\n        \"anti_scraping\": None,\n        \"selector_match\": False,\n        \"items_found\": 0,\n        \"page_title\": None\n    }\n    \n    try:\n        # 访问页面\n        response = await page.goto(site[\"url\"], wait_until=\"networkidle\", timeout=30000)\n        result[\"status_code\"] = response.status\n        result[\"page_title\"] = await page.title()\n        \n        # 检查反爬\n        content = await page.content()\n        anti_scraping_signals = [\n            \"验证码\", \"captcha\", \"安全验证\", \"访问被拒绝\", \"拒绝访问\",\n            \"IP被封禁\", \"blocked\", \"forbidden\", \"403 Forbidden\",\n            \"请输入验证码\", \"人机验证\", \"Cloudflare\", \"ddos\"\n        ]\n        \n        for signal in anti_scraping_signals:\n            if signal.lower() in content.lower():\n                result[\"anti_scraping\"] = f\"检测到反爬信号: {signal}\"\n                break\n        \n        # 检查选择器\n        list_selector = site[\"selector\"][\"list\"]\n        try:\n            await page.wait_for_selector(list_selector, timeout=10000)\n            items = await page.query_selector_all(list_selector)\n            result[\"items_found\"] = len(items)\n            result[\"selector_match\"] = len(items) > 0\n            \n            if len(items) > 0:\n                # 测试提取第一条\n                first = items[0]\n                title = await first.query_selector(site[\"selector\"][\"title\"])\n                date = await first.query_selector(site[\"selector\"][\"date\"])\n                link = await first.query_selector(site[\"selector\"][\"link\"])\n                \n                result[\"title_extracted\"] = await title.text_content() if title else None\n                result[\"date_extracted\"] = await date.text_content() if date else None\n                result[\"link_extracted\"] = await link.get_attribute(\"href\") if link else None\n        except Exception as e:\n            result[\"selector_error\"] = str(e)\n        \n        result[\"success\"] = response.ok and result[\"selector_match\"] and not result[\"anti_scraping\"]\n        \n    except Exception as e:\n        result[\"error\"] = str(e)\n    \n    return result\n\nasync def main():\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        context = await browser.new_context(user_agent=USER_AGENT)\n        \n        results = []\n        for site in TEST_SITES:\n            print(f\"测试站点: {site['name']}\")\n            page = await context.new_page()\n            res = await test_site(page, site)\n            results.append(res)\n            await page.close()\n            print(f\"结果: {'成功' if res['success'] else '失败'}, 条目数: {res['items_found']}, 反爬: {res['anti_scraping'] or '无'}, 错误: {res['error'] or '无'}\")\n        \n        await browser.close()\n        \n        # 输出结果\n        print(\"\\n\\n\" + \"=\"*80)\n        print(\"测试报告\")\n        print(\"=\"*80)\n        for res in results:\n            print(f\"\\n📌 {res['name']} ({res['url']})\")\n            print(f\"   状态: {'✅ 成功' if res['success'] else '❌ 失败'}\")\n            if res.get('status_code'):\n                print(f\"   HTTP状态码: {res['status_code']}\")\n            print(f\"   页面标题: {res['page_title']}\")\n            if res['anti_scraping']:\n                print(f\"   ⚠️ 反爬检测: {res['anti_scraping']}\")\n            else:\n                print(f\"   ⚠️ 反爬检测: 无\")\n            print(f\"   选择器匹配: {'✅ 匹配' if res['selector_match'] else '❌ 不匹配'}\")\n            print(f\"   找到条目数: {res['items_found']}\")\n            if res.get('title_extracted'):\n                print(f\"   第一条标题: {res['title_extracted'].strip()[:50]}...\")\n            if res['error']:\n                print(f\"   ❌ 错误信息: {res['error']}\")\n        \n        # 保存结果\n        with open(\"/home/yankeeting/.openclaw/workspace/failed-sites-test-result.json\", \"w\", encoding=\"utf-8\") as f:\n            json.dump(results, f, ensure_ascii=False, indent=2)\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773429474910}}
