},\n        {\n          \"selector\": \".list\",\n          \"childCount\": 1,\n          \"class\": \"list\"\n        },\n        {\n          \"selector\": \".list\",\n          \"childCount\": 1,\n          \"class\": \"list\"\n        }\n      ]\n    }\n  },\n  {\n    \"name\": \"厦门科学技术局\",\n    \"url\": \"http://sti.xm.gov.cn/\",\n    \"status\": 200,\n    \"title\": \"厦门市科学技术局\",\n    \"totalLinks\": 91,\n    \"sampleLinks\": [\n      {\n        \"text\": \"国务院\",\n        \"href\": \"https://www.gov.cn/\"\n      },\n      {\n        \"text\": \"省政府\",\n        \"href\": \"https://www.fujian.gov.cn/\"\n      },\n      {\n        \"text\": \"市政府\",\n        \"href\": \"http://www.xm.gov.cn/\"\n      },\n      {\n        \"text\": \"市人大\",\n        \"href\": \"https://www.xmrd.gov.cn/\"\n      },\n      {\n        \"text\": \"市政协\",\n        \"href\": \"http://www.zxxm.gov.cn/\"\n      },\n      {\n        \"text\": \"首页\",\n        \"href\": \"http://sti.xm.gov.cn/\"\n      },\n      {\n        \"text\": \"新闻动态\",\n        \"href\": \"http://sti.xm.gov.cn/xwdt/\"\n      },\n      {\n        \"text\": \"政务公开\",\n        \"href\": \"http://sti.xm.gov.cn/xxgk/\"\n      },\n      {\n        \"text\": \"办事服务\",\n        \"href\": \"https://zwfw.fujian.gov.cn/person-todo/detail?userType=3&siteUnid=8B843B8A862B176279921293FF24876A&curStatus=dept&deptId=CF6DEF15B2B42B8DEEF10B547074140B\"\n      },\n      {\n        \"text\": \"科技服务\",\n        \"href\": \"http://sti.xm.gov.cn/wsbs/\"\n      },\n      {\n        \"text\": \"交流互动\",\n        \"href\": \"http://sti.xm.gov.cn/jlhd/\"\n      },\n      {\n        \"text\": \"走进厦门科学城\",\n        \"href\": \"http://sti.xm.gov.cn/zjkxc/\"\n      },\n      {\n        \"text\": \"7个前沿AI项目集中在厦门科学城I号孵化器亮相 ——“技术源头...\",\n        \"href\": \"https://mp.weixin.qq.com/s/U10L0J4EXoy-zubhU4Vy0Q\"\n      },\n      {\n        \"text\": \"我市召开2025年度高企认定中介机构工作培训会\",\n        \"href\": \"http://sti.xm.gov.cn/xxgk/gzdt/202506/t20250620_2940521.htm\"\n      },\n      {\n        \"text\": \"第十四届“中国创新创业大赛”（厦门赛区）、第十届“创客中...\",\n        \"href\": \"http://sti.xm.gov.cn/xxgk/gzdt/202506/t20250620_2940375.htm\"\n      },\n      {\n        \"text\": \"全球智汇  聚力未来 第三届“苏颂杯”未来产业技术创新赛启幕\",\n        \"href\": \"http://sti.xm.gov.cn/xwdt/ldxw/202506/t20250618_2939785.htm\"\n      },\n      {\n        \"text\": \"中国—金砖国家新时代科创孵化园在巴西成功举办展示暨推介会\",\n        \"href\": \"http://sti.xm.gov.cn/xxgk/gzdt/202506/t20250613_2938800.htm\"\n      },\n      {\n        \"text\": \"通知公告\",\n        \"href\": \"http://sti.xm.gov.cn/xxgk/tzgg/\"\n      },\n      {\n        \"text\": \"工作动态\",\n        \"href\": \"http://sti.xm.gov.cn/xxgk/gzdt/\"\n      },\n      {\n        \"text\": \"科技新闻\",\n        \"href\": \"http://sti.xm.gov.cn/xwdt/ldxw/\"\n      }\n    ],\n    \"domStructure\": {\n      \"bodyDirectChildren\": [\n        {\n          \"tag\": \"div\",\n          \"id\": \"ad1\",\n          \"class\": null\n        },\n        {\n          \"tag\": \"div\",\n          \"id\": null,\n          \"class\": \"wrap\"\n        }\n      ],\n      \"contentAreas\": [\n        {\n          \"selector\": \".main\",\n          \"id\": null,\n          \"class\": \"main\",\n          \"childCount\": 5\n        }\n      ],\n      \"listContainers\": [\n        {\n          \"selector\": \"ul\",\n          \"childCount\": 7,\n          \"class\": \"clearflx\"\n        },\n        {\n          \"selector\": \"ul\",\n          \"childCount\": 5,\n          \"class\": \"pic\"\n        },\n        {\n          \"selector\": \"ul\",\n          \"childCount\": 5,\n          \"class\": \"num\"\n        },\n        {\n          \"selector\": \"ul\",\n          \"childCount\": 3,\n          \"class\": null\n        },\n        {\n          \"selector\": \"ul\",\n          \"childCount\": 6,\n          \"class\": null\n        },\n        {\n          \"selector\": \"ul\",\n          \"childCount\": 6,\n          \"class\": null\n        },\n        {\n