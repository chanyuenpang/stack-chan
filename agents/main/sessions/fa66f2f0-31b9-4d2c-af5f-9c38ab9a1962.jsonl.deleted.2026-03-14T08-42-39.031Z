{"type":"message","id":"265f9632","parentId":"ac18f720","timestamp":"2026-03-14T07:43:37.579Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"目录已创建。现在我来编写一个 Playwright 脚本来访问这三个网站并抓取信息。\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_daafd57ba45644c8a19daa6a","name":"write","arguments":{"path":"/home/yankeeting/.openclaw/workspace/test_scrape.js","content":"const { chromium } = require('playwright');\nconst fs = require('fs');\nconst path = require('path');\n\nconst urls = [\n  {\n    name: '厦门市人力资源和社会保障局',\n    url: 'http://hrss.xm.gov.cn/xygk/tzgg/'\n  },\n  {\n    name: '厦门科学技术局',\n    url: 'http://sti.xm.gov.cn/'\n  },\n  {\n    name: '福建省科技厅',\n    url: 'http://kjt.fujian.gov.cn/'\n  }\n];\n\nasync function scrape() {\n  const browser = await chromium.launch({ headless: true });\n  const context = await browser.newContext({\n    userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n  });\n\n  const results = [];\n\n  for (const site of urls) {\n    console.log(`\\n=== 正在抓取: ${site.name} ===`);\n    console.log(`URL: ${site.url}`);\n\n    try {\n      const page = await context.newPage();\n      \n      // 设置超时\n      page.setDefaultTimeout(30000);\n\n      // 访问页面\n      const response = await page.goto(site.url, { \n        waitUntil: 'domcontentloaded',\n        timeout: 30000 \n      });\n      \n      console.log(`状态码: ${response.status()}`);\n\n      // 等待页面加载\n      await page.waitForTimeout(3000);\n\n      // 截图\n      const screenshotPath = path.join(__dirname, `screenshot_${site.name.replace(/[^a-zA-Z0-9]/g, '_')}.png`);\n      await page.screenshot({ path: screenshotPath, fullPage: true });\n      console.log(`截图已保存: ${screenshotPath}`);\n\n      // 获取页面标题\n      const title = await page.title();\n      console.log(`页面标题: ${title}`);\n\n      // 获取所有可见链接\n      const links = await page.evaluate(() => {\n        const linkElements = document.querySelectorAll('a[href]');\n        const linkData = [];\n        \n        linkElements.forEach((link, index) => {\n          const href = link.href;\n          const text = link.textContent?.trim() || '';\n          \n          // 只保留有实际内容的链接\n          if (text && href && !href.startsWith('javascript:') && !href.startsWith('mailto:')) {\n            linkData.push({\n              text: text.substring(0, 100), // 限制文本长度\n              href: href\n            });\n          }\n        });\n        \n        return linkData;\n      });\n\n      console.log(`找到 ${links.length} 个链接`);\n\n      // 分析 DOM 结构 - 获取主要容器\n      const domStructure = await page.evaluate(() => {\n        const getStructure = (element, depth = 0, maxDepth = 4) => {\n          if (depth > maxDepth || !element) return null;\n          \n          const result = {\n            tag: element.tagName?.toLowerCase() || 'unknown',\n            id: element.id || null,\n            class: element.className?.toString().substring(0, 100) || null,\n            children: []\n          };\n\n          // 获取主要属性\n          if (element.id) result.id = element.id;\n          if (element.className && typeof element.className === 'string') {\n            result.class = element.className.split(' ').filter(c => c).slice(0, 5).join(' ');\n          }\n\n          // 递归子元素\n          const children = element.children;\n          for (let i = 0; i < Math.min(children.length, 10); i++) {\n            const childStruct = getStructure(children[i], depth + 1, maxDepth);\n            if (childStruct && childStruct.tag !== 'script' && childStruct.tag !== 'style') {\n              result.children.push(childStruct);\n            }\n          }\n\n          return result;\n        };\n\n        // 分析 body 下的直接子元素\n        const body = document.body;\n        if (!body) return { error: 'No body found' };\n\n        const mainContent = {\n          bodyDirectChildren: []\n        };\n\n        Array.from(body.children).forEach(child => {\n          const tag = child.tagName?.toLowerCase();\n          if (tag && tag !== 'script' && tag !== 'style') {\n            const info = {\n              tag: tag,\n              id: child.id || null,\n              class: child.className?.toString?.().split(' ').filter(c => c).slice(0, 3).join(' ') || null\n            };\n            if (child.id) info.id = child.id;\n            mainContent.bodyDirectChildren.push(info);\n          }\n        });\n\n        // 查找可能的内容区域\n        const contentSelectors = ['main', 'article', 'section', 'div[role=\"main\"]', '.content', '#content', '.main', '#main'];\n        const foundContentAreas = [];\n        \n        for (const sel of contentSelectors) {\n          try {\n            const els = document.querySelectorAll(sel);\n            if (els.length > 0) {\n              els.forEach(el => {\n                foundContentAreas.push({\n                  selector: sel,\n                  id: el.id || null,\n                  class: el.className?.toString?.().split(' ').filter(c => c).slice(0, 3).join(' ') || null,\n                  childCount: el.children.length\n                });\n              });\n            }\n          } catch (e) {}\n        }\n        \n        mainContent.contentAreas = foundContentAreas;\n\n        // 查找公告列表常见的容器\n        const listContainers = [];\n        const possibleListSelectors = ['ul', 'ol', '.list', '.news-list', '.notice-list', '.公告', '.通知'];\n        \n        for (const sel of possibleListSelectors) {\n          try {\n            const els = document.querySelectorAll(sel);\n            if (els.length > 0) {\n              els.forEach(el => {\n                if (el.children.length > 0) {\n                  listContainers.push({\n                    selector: sel,\n                    childCount: el.children.length,\n                    class: el.className?.toString?.().substring(0, 50) || null\n                  });\n                }\n              });\n            }\n          } catch (e) {}\n        }\n        \n        mainContent.listContainers = listContainers.slice(0, 10);\n\n        return mainContent;\n      });\n\n      // 提取前20个链接作为示例\n      const sampleLinks = links.slice(0, 20);\n\n      results.push({\n        name: site.name,\n        url: site.url,\n        status: response.status(),\n        title: title,\n        totalLinks: links.length,\n        sampleLinks: sampleLinks,\n        domStructure: domStructure\n      });\n\n      await page.close();\n\n    } catch (error) {\n      console.error(`Error scraping ${site.name}:`, error.message);\n      results.push({\n        name: site.name,\n        url: site.url,\n        error: error.message\n      });\n    }\n  }\n\n  await browser.close();\n\n  // 保存结果\n  const outputPath = path.join(__dirname, 'test_results.json');\n  fs.writeFileSync(outputPath, JSON.stringify(results, null, 2));\n  console.log(`\\n结果已保存到: ${outputPath}`);\n\n  return results;\n}\n\nscrape().catch(console.error);"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773474137794}}
