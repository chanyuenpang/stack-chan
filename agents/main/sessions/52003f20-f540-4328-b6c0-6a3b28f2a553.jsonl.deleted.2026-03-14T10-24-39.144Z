{"type":"message","id":"11f75e2d","parentId":"0060192e","timestamp":"2026-03-14T09:26:48.977Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"看来选择器找到了元素但没有成功提取到公告内容。让我修改脚本，更好地提取数据。\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"选择器找到元素但提取失败，让我修复一下提取逻辑：\n\n"},{"type":"toolCall","id":"call_e04b5f5bd33d416198df0a8b","name":"write","arguments":{"content":"#!/usr/bin/env python3\nimport json\nimport random\nfrom playwright.sync_api import sync_playwright\n\n# 读取目标列表\nwith open('/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/targets.json', 'r') as f:\n    data = json.load(f)\n\n# 随机选3个\ntargets = random.sample(data['targets'], 3)\n\nprint(\"选中的网站:\")\nfor t in targets:\n    print(f\"  - {t['name']}: {t['url']}\")\n\nresults = []\n\ndef scrape_site(name, url):\n    \"\"\"抓取单个网站\"\"\"\n    print(f\"\\n正在抓取: {name}\")\n    \n    announcements = []\n    structure = {}\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n        \n        try:\n            response = page.goto(url, timeout=15000, wait_until='domcontentloaded')\n            if response and response.status >= 400:\n                print(f\"  页面返回错误: {response.status}\")\n                return None\n            page.wait_for_timeout(3000)\n            \n            # 尝试多个选择器找列表项\n            list_patterns = [\n                ('div.list ul li', 'a', 'span'),\n                ('div.news_list ul li', 'a', None),\n                ('ul.newsList li', 'a', None),\n                ('div.article-list li', 'a', None),\n                ('table.list tr', 'td a', 'td:last-child'),\n                ('div.tzgg ul li', 'a', None),\n                ('div.notice-list li', 'a', None),\n                ('.newslist li', 'a', None),\n                ('.list-content li', 'a', None),\n                ('.contList li', 'a', None),\n                ('ul li', 'a', '.date, span.date, div.time'),\n                ('div ul li', 'a', None),\n                ('li', 'a', None),\n            ]\n            \n            found = False\n            for container_sel, link_sel, date_sel in list_patterns:\n                try:\n                    items = page.query_selector_all(container_sel)\n                    if items and len(items) >= 3:\n                        print(f\"  找到容器: {container_sel}, {len(items)} 项\")\n                        \n                        for item in items[:5]:\n                            try:\n                                # 找链接\n                                link = item.query_selector('a')\n                                if not link:\n                                    continue\n                                    \n                                title = link.inner_text().strip()\n                                href = link.get_attribute('href')\n                                \n                                if not title or len(title) < 2:\n                                    continue\n                                    \n                                # 找日期\n                                date = \"\"\n                                if date_sel:\n                                    date_elem = item.query_selector(date_sel)\n                                    if date_elem:\n                                        date = date_elem.inner_text().strip()\n                                else:\n                                    # 尝试常见日期选择器\n                                    for ds in ['.date', '.time', 'span.date', 'span.time', 'div.date']:\n                                        de = item.query_selector(ds)\n                                        if de:\n                                            date = de.inner_text().strip()\n                                            break\n                                \n                                announcements.append({\n                                    'title': title[:100],\n                                    'date': date,\n                                    'link': href if href else \"\"\n                                })\n                                found = True\n                            except Exception as e:\n                                continue\n                        \n                        if found:\n                            break\n                except:\n                    continue\n            \n            # 分析页面结构\n            structure = {\n                '页面标题': page.title() if page.title() else \"N/A\",\n                '找到的公告数': len(announcements)\n            }\n            \n            # 尝试找内容区域\n            content_selectors = ['div.content', 'div.main', 'div#content', 'main', '.content']\n            for sel in content_selectors:\n                el = page.query_selector(sel)\n                if el:\n                    structure['内容区域'] = sel\n                    break\n            \n            # 统计链接\n            all_links = page.query_selector_all('a')\n            structure['总链接数'] = len(all_links)\n            \n        except Exception as e:\n            print(f\"  错误: {str(e)}\")\n            structure = {\"error\": str(e)}\n        \n        browser.close()\n    \n    return {\n        'name': name,\n        'url': url,\n        'announcements': announcements[:5],\n        'structure': structure\n    }\n\n# 执行抓取\nfor t in targets:\n    result = scrape_site(t['name'], t['url'])\n    if result:\n        results.append(result)\n\n# 输出结果\nprint(\"\\n\\n=== 抓取结果 ===\")\nfor r in results:\n    print(f\"\\n{r['name']}:\")\n    print(f\"  公告数: {len(r['announcements'])}\")\n    for i, a in enumerate(r['announcements'], 1):\n        print(f\"    {i}. {a['title'][:60]} | {a['date']}\")\n\n# 保存为JSON\nwith open('/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/output/2026-03-14/data.json', 'w', encoding='utf-8') as f:\n    json.dump(results, f, ensure_ascii=False, indent=2)\n\nprint(\"\\n数据已保存\")","path":"~/.openclaw/workspace/skills/adaptive-announcement-scraper/scrape.py"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773480343168}}
