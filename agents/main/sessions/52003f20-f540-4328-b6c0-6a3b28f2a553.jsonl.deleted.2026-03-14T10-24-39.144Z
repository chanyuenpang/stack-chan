{"type":"message","id":"207a8aa2","parentId":"de673821","timestamp":"2026-03-14T09:25:14.840Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在我需要使用Playwright来访问这些网站。让我先用Python创建一个脚本来：\n1. 随机选择3个网站\n2. 用Playwright访问并提取公告\n3. 分析页面结构\n\n我会写一个Python脚本来做这些工作。\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"现在用 Playwright 编写抓取脚本：\n"},{"type":"toolCall","id":"call_6ceb20d556434569bb5791cf","name":"write","arguments":{"path":"~/.openclaw/workspace/skills/adaptive-announcement-scraper/scrape.py","content":"#!/usr/bin/env python3\nimport json\nimport random\nfrom playwright.sync_api import sync_playwright\nfrom datetime import datetime\n\n# 读取目标列表\nwith open('/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/targets.json', 'r') as f:\n    data = json.load(f)\n\n# 随机选3个\ntargets = random.sample(data['targets'], 3)\n\nprint(\"选中的网站:\")\nfor t in targets:\n    print(f\"  - {t['name']}: {t['url']}\")\n\nresults = []\n\ndef scrape_site(name, url):\n    \"\"\"抓取单个网站\"\"\"\n    print(f\"\\n正在抓取: {name}\")\n    \n    announcements = []\n    selectors_tried = []\n    \n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True)\n        page = browser.new_page()\n        \n        # 常见公告列表的选择器\n        list_selectors = [\n            'div.news_list ul li a',\n            'div.list ul li a', \n            'ul.newsList li a',\n            'div.article-list a',\n            'table.list tr td a',\n            'div.tzgg ul li a',\n            'div.notice-list li a',\n            'div.news ul li a',\n            '.newslist a',\n            '#newslist a',\n            '.list-content li a',\n            '.contList li a',\n            '.txtList li a'\n        ]\n        \n        date_selectors = [\n            'span.date',\n            'div.time',\n            'li .time',\n            '.date',\n            '.time',\n            'td:nth-child(2)',\n            'span.pubdate'\n        ]\n        \n        try:\n            # 尝试访问页面\n            response = page.goto(url, timeout=15000, wait_until='domcontentloaded')\n            if response and response.status >= 400:\n                print(f\"  页面返回错误: {response.status}\")\n                return None\n            page.wait_for_timeout(3000)\n            \n            # 尝试每个选择器\n            for sel in list_selectors:\n                try:\n                    items = page.query_selector_all(sel)\n                    if items and len(items) > 0:\n                        selectors_tried.append(sel)\n                        print(f\"  使用选择器: {sel}, 找到 {len(items)} 条\")\n                        \n                        for item in items[:5]:\n                            try:\n                                title = item.inner_text().strip()\n                                href = item.get_attribute('href')\n                                if title and len(title) > 0:\n                                    # 尝试获取日期\n                                    date = \"\"\n                                    parent = item\n                                    for _ in range(5):\n                                        parent = parent.evaluate_node('el => el.parentElement')\n                                        if parent:\n                                            for date_sel in date_selectors:\n                                                date_elem = parent.query_selector(date_sel)\n                                                if date_elem:\n                                                    date = date_elem.inner_text().strip()\n                                                    break\n                                            if date:\n                                                break\n                                    \n                                    announcements.append({\n                                        'title': title[:100],\n                                        'date': date,\n                                        'link': href if href else \"\"\n                                    })\n                            except:\n                                continue\n                        \n                        if announcements:\n                            break\n                except:\n                    continue\n            \n            # 分析页面结构\n            structure = analyze_structure(page)\n            \n        except Exception as e:\n            print(f\"  错误: {str(e)}\")\n            structure = {\"error\": str(e)}\n        \n        browser.close()\n    \n    return {\n        'name': name,\n        'url': url,\n        'announcements': announcements[:5],\n        'selectors_tried': selectors_tried,\n        'structure': structure\n    }\n\ndef analyze_structure(page):\n    \"\"\"分析页面结构\"\"\"\n    structure = {}\n    \n    # 尝试识别主要容器\n    containers = [\n        ('header', 'header'),\n        ('导航', 'nav'),\n        ('主要内容', 'main'),\n        ('侧边栏', 'aside'),\n        ('页脚', 'footer')\n    ]\n    \n    for name, sel in containers:\n        el = page.query_selector(sel)\n        if el:\n            structure[name] = sel\n    \n    # 尝试找到内容区域\n    content_selectors = ['div.content', 'div.main', 'div.news', 'div.list', '.content', '.main']\n    for sel in content_selectors:\n        el = page.query_selector(sel)\n        if el:\n            structure['内容区域'] = sel\n            break\n    \n    # 查找所有链接，了解导航结构\n    try:\n        all_links = page.query_selector_all('a')\n        structure['总链接数'] = len(all_links)\n    except:\n        pass\n    \n    return structure\n\n# 执行抓取\nfor t in targets:\n    result = scrape_site(t['name'], t['url'])\n    if result:\n        results.append(result)\n\n# 输出结果\nprint(\"\\n\\n=== 抓取结果 ===\")\nfor r in results:\n    print(f\"\\n{r['name']}:\")\n    print(f\"  公告数: {len(r['announcements'])}\")\n    for a in r['announcements']:\n        print(f\"    - {a['title'][:50]}... | {a['date']}\")\n\n# 保存为JSON供后续处理\nwith open('/home/yankeeting/.openclaw/workspace/skills/adaptive-announcement-scraper/output/2026-03-14/data.json', 'w', encoding='utf-8') as f:\n    json.dump(results, f, ensure_ascii=False, indent=2)\n\nprint(\"\\n数据已保存到 data.json\")"}}],"api":"openai-completions","provider":"volces-com","model":"ark-code-latest","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1773480249259}}
