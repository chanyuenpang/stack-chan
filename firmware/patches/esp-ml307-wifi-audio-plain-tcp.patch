+bool EspTcp::SetSendTimeout(int timeout_ms) {
+    if (tcp_fd_ < 0 || timeout_ms <= 0) {
+        last_error_ = EINVAL;
+        return false;
+    }
+    timeval timeout{};
+    timeout.tv_sec = timeout_ms / 1000;
+    timeout.tv_usec = (timeout_ms % 1000) * 1000;
+    if (setsockopt(tcp_fd_, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) != 0) {
+        last_error_ = errno;
+        ESP_LOGE(TAG, "Failed to set send timeout: errno=%d", last_error_);
+        return false;
+    }
+    return true;
+}
+
+bool EspTcp::SetNoDelay(bool enabled) {
+    if (tcp_fd_ < 0) {
+        last_error_ = EINVAL;
+        return false;
+    }
+    const int value = enabled ? 1 : 0;
+    if (setsockopt(tcp_fd_, IPPROTO_TCP, TCP_NODELAY, &value, sizeof(value)) != 0) {
+        last_error_ = errno;
+        ESP_LOGE(TAG, "Failed to configure TCP_NODELAY: errno=%d", last_error_);
+        return false;
+    }
+    return true;
+}
